#!/usr/bin/env python3
"""Web search for agents, through the local RustXNG metasearch service (no API key).

  websearch <query words...> [-n N] [--time day|week|month|year] [--page P] [--json]

Prints numbered results: title, URL and a snippet. Engines that failed are listed at the end.
Bangs select one engine: `websearch !github aave liquidator`, `websearch !wikipedia ...`.
Read a result page with your fetch tool (web_fetch / curl); this command only searches.
"""
import json
import os
import sys
import urllib.parse
import urllib.request

BASE = os.environ.get("RUSTXNG_URL", "http://127.0.0.1:29483")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    n, time_range, page, raw, words = 10, None, 1, False, []
    it = iter(argv)
    for a in it:
        if a == "-n":
            n = int(next(it))
        elif a == "--time":
            time_range = next(it)
            if time_range not in ("day", "week", "month", "year"):
                print("websearch: --time must be day, week, month or year", file=sys.stderr)
                return 2
        elif a == "--page":
            page = int(next(it))
        elif a == "--json":
            raw = True
        else:
            words.append(a)
    q = " ".join(words).strip()
    if not q:
        print("websearch: empty query", file=sys.stderr)
        return 2
    params = {"q": q, "format": "json", "pageno": str(page)}
    if time_range:
        params["time_range"] = time_range
    url = f"{BASE}/search?{urllib.parse.urlencode(params)}"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"Accept": "application/json"}),
                                    timeout=60) as r:
            data = json.loads(r.read())
    except Exception as exc:                                       # service down, timeout, bad JSON
        print(f"websearch: {BASE} failed: {exc}", file=sys.stderr)
        return 1
    if raw:
        print(json.dumps(data, ensure_ascii=False, indent=1))
        return 0
    results = data.get("results") or []
    for i, x in enumerate(results[:n], 1):
        snippet = " ".join((x.get("content") or "").split())
        print(f"{i}. {x.get('title') or '(no title)'}\n   {x.get('url')}")
        if snippet:
            print(f"   {snippet[:300]}")
    if not results:
        print("(no results)")
    bad = data.get("unresponsive_engines") or []
    if bad:
        print("unresponsive engines: " + ", ".join(f"{e[0]} ({e[1]})" if isinstance(e, list) and len(e) > 1
                                                    else str(e) for e in bad))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
