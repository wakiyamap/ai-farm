#!/usr/bin/env python3
"""Wait until the RPC relay answers a real chain read, then exit 0. Standard library only.

  relay-wait [seconds=150] [chain=ethereum]

Used as ExecStartPre of farm-signer (10j). At boot the relay process is "started" before name
resolution works; its first upstream calls fail and it rests the providers for a while. The signer
verifies its price feeds at start, exits when they cannot be read, and every one of its restarts
also restarts all live bots (bot@ Requires= the signer) until they hit their start limit.
Always exits 0: after the wait the signer starts and decides for itself, exactly as before.
"""
import json
import sys
import time
import urllib.request

URL = "http://127.0.0.1:8545"


def ok(url, chain):
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "eth_blockNumber", "params": []}).encode()
    req = urllib.request.Request(f"{url}/{chain}?lane=live", data=body, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            out = json.loads(r.read())
        return int(out["result"], 16) > 0
    except Exception:                                  # noqa: BLE001 - anything means "not yet"
        return False


def main(argv, url=URL, pause=3.0):
    limit = float(argv[0]) if argv else 150.0
    chain = argv[1] if len(argv) > 1 else "ethereum"
    try:
        with open("/etc/farm/gate.json", encoding="utf-8") as f:
            url = json.load(f).get("relay_url", url) if url == URL else url
    except (OSError, ValueError):
        pass
    t0 = time.monotonic()
    tries = 0
    while True:
        tries += 1
        if ok(url, chain):
            print(f"relay-wait: relay answers on {chain} after {time.monotonic() - t0:.0f}s ({tries} tries)", file=sys.stderr)
            return 0
        if time.monotonic() - t0 + pause > limit:
            print(f"relay-wait: relay still not answering on {chain} after {limit:.0f}s; starting anyway", file=sys.stderr)
            return 0
        time.sleep(pause)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
