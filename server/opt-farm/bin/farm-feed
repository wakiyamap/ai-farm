#!/usr/bin/env python3
"""Farm feed: wait for the chain instead of polling it.

One WebSocket per chain to Alchemy (eth_subscribe), shared by every bot, served to local callers as
plain HTTP long-polls:

  GET http://127.0.0.1:8546/head/<chain>?after=<number>&timeout=<s>
      Returns as soon as the chain has a head above <after> (newHeads). Only on the chains listed
      under "heads" in /etc/farm/feed.json: a head costs about 55 CU, so fast chains are excluded.
  GET http://127.0.0.1:8546/logs/<chain>?address=<a>[,<a>..]&topic0=<t>[,<t>..]&after=<cursor>&timeout=<s>
      Returns as soon as a matching log arrives. Without `after` it subscribes and returns the
      starting cursor. `"gap": true` means the stream was interrupted (reconnect, restart, buffer
      overrun): logs may have been missed, so re-read the chain through the relay and continue from
      the returned cursor.
  GET http://127.0.0.1:8546/health

A subscription exists only while somebody polls it (dropped after "idle_unsubscribe_s"), so the feed
costs nothing when no bot uses it. Alchemy bills subscriptions at 0.04 CU per byte delivered; the
feed counts the bytes, stops everything for the rest of the UTC day at "daily_cu_budget", and drops a
single log filter that passes "per_filter_daily_cu". On any error or 429/503 a caller falls back to
polling the relay. This service never sends a transaction and cannot: it only reads.

  farm-feed --check [chain]    connect, wait for one head, print its size and cost, exit

Standard library only (the WebSocket client below is the part of RFC 6455 this needs).
Config: /etc/farm/feed.json (optional), /etc/farm/relay.json (chain -> Alchemy subdomain),
key: /etc/farm/alchemy.key.
"""
import base64
import collections
import datetime as dt
import hashlib
import http.server
import json
import os
import re
import select
import socket
import socketserver
import ssl
import struct
import sys
import threading
import time
import urllib.parse

FEED_CONFIG = "/etc/farm/feed.json"
RELAY_CONFIG = "/etc/farm/relay.json"
KEY_PATH = "/etc/farm/alchemy.key"

DEFAULTS = {
    "bind": "127.0.0.1",
    "port": 8546,
    "heads": ["ethereum"],            # chains where /head is offered (about 55 CU per block)
    "daily_cu_budget": 700000,        # everything stops for the UTC day above this
    "per_filter_daily_cu": 150000,    # one log filter above this is dropped for the UTC day
    "max_log_filters_per_chain": 8,
    "max_addresses_per_filter": 20,
    "idle_unsubscribe_s": 180,        # nobody polled a subscription for this long: unsubscribe
    "max_wait_s": 60,                 # longest long-poll
    "buffer_logs": 2000,              # logs kept per filter for slow pollers
    "max_waiters": 64,
    "ws_url": "wss://{slug}.g.alchemy.com/v2/{key}",
}
CU_PER_BYTE = 0.04                    # alchemy.com/support/how-are-websockets-priced
GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
MAX_MESSAGE = 16 << 20
ADDR_RE = re.compile(r"^0x[0-9a-fA-F]{40}$")
TOPIC_RE = re.compile(r"^0x[0-9a-fA-F]{64}$")


def utc_day():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d")


def say(msg):
    print(f"farm-feed: {msg}", file=sys.stderr, flush=True)


class WSError(Exception):
    pass


class WS:
    """Minimal RFC 6455 client: text messages, fragmentation, ping/pong, close. No extensions.
    All socket I/O happens on the one thread that owns the object."""

    def __init__(self, url, timeout=15):
        u = urllib.parse.urlsplit(url)
        if u.scheme not in ("ws", "wss") or not u.hostname:
            raise WSError("bad websocket url")
        port = u.port or (443 if u.scheme == "wss" else 80)
        path = (u.path or "/") + (f"?{u.query}" if u.query else "")
        raw = socket.create_connection((u.hostname, port), timeout=timeout)
        raw.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        if u.scheme == "wss":
            self.sock = ssl.create_default_context().wrap_socket(raw, server_hostname=u.hostname)
        else:
            self.sock = raw
        self.buf = bytearray()
        self.frag = None
        key = base64.b64encode(os.urandom(16)).decode()
        host = u.hostname + (f":{u.port}" if u.port else "")
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
                           f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                           "Sec-WebSocket-Version: 13\r\nUser-Agent: farm-feed/1.0\r\n\r\n").encode())
        while b"\r\n\r\n" not in self.buf:
            if len(self.buf) > 16384:
                raise WSError("handshake reply too large")
            chunk = self.sock.recv(4096)
            if not chunk:
                raise WSError("connection closed during the handshake")
            self.buf += chunk
        head, _, rest = bytes(self.buf).partition(b"\r\n\r\n")
        self.buf = bytearray(rest)
        lines = head.decode("latin-1").split("\r\n")
        if len(lines[0].split()) < 2 or lines[0].split()[1] != "101":
            raise WSError(f"handshake refused: {lines[0][:80]}")
        headers = {k.strip().lower(): v.strip() for k, _, v in (ln.partition(":") for ln in lines[1:])}
        want = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()
        if headers.get("sec-websocket-accept") != want:
            raise WSError("handshake: wrong Sec-WebSocket-Accept")
        self.sock.settimeout(1.0)

    def _send(self, opcode, payload=b""):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack("!H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack("!Q", n)
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i & 3] for i, b in enumerate(payload))
        self.sock.sendall(head + mask + masked)

    def send_text(self, text):
        self._send(0x1, text.encode())

    def ping(self):
        self._send(0x9, b"farm")

    def pong(self, payload):
        self._send(0xA, payload[:125])

    def close(self):
        try:
            self._send(0x8, struct.pack("!H", 1000))
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass

    def read(self, timeout, wake=None):
        """Wait up to `timeout` for bytes (or for `wake` to become readable). True if bytes came."""
        pending = getattr(self.sock, "pending", lambda: 0)()
        if not pending:
            watch = [self.sock] + ([wake] if wake is not None else [])
            ready, _, _ = select.select(watch, [], [], timeout)
            if wake is not None and wake in ready:
                try:
                    wake.recv(4096)
                except OSError:
                    pass
            if self.sock not in ready:
                return False
        try:
            chunk = self.sock.recv(65536)
        except (socket.timeout, ssl.SSLWantReadError):
            return False
        if not chunk:
            raise WSError("connection closed by the server")
        self.buf += chunk
        return True

    def _frame(self):
        b = self.buf
        if len(b) < 2:
            return None
        fin, op, masked, n, off = b[0] & 0x80, b[0] & 0x0F, b[1] & 0x80, b[1] & 0x7F, 2
        if n == 126:
            if len(b) < 4:
                return None
            n, off = struct.unpack("!H", bytes(b[2:4]))[0], 4
        elif n == 127:
            if len(b) < 10:
                return None
            n, off = struct.unpack("!Q", bytes(b[2:10]))[0], 10
        if n > MAX_MESSAGE:
            raise WSError(f"frame of {n} bytes")
        mask = None
        if masked:
            if len(b) < off + 4:
                return None
            mask, off = bytes(b[off:off + 4]), off + 4
        if len(b) < off + n:
            return None
        payload = bytes(b[off:off + n])
        del b[:off + n]
        if mask:
            payload = bytes(c ^ mask[i & 3] for i, c in enumerate(payload))
        return bool(fin), op, payload

    def next_message(self):
        """(opcode, payload) of the next complete message in the buffer, or None."""
        while True:
            f = self._frame()
            if f is None:
                return None
            fin, op, payload = f
            if op >= 0x8:                       # control frames are never fragmented
                return op, payload
            if op in (0x1, 0x2):
                self.frag = [op, bytearray(payload)]
            elif op == 0x0 and self.frag is not None:
                self.frag[1] += payload
                if len(self.frag[1]) > MAX_MESSAGE:
                    raise WSError("message too large")
            else:
                raise WSError("unexpected continuation frame")
            if fin:
                done, self.frag = self.frag, None
                return done[0], bytes(done[1])


class Sub:
    def __init__(self, key, kind, params, buffer_logs):
        self.key, self.kind, self.params = key, kind, params
        self.state = "new"            # new -> pending -> active | failed
        self.sub_id = None
        self.error = ""
        self.epoch = 0
        self.seq = 0
        self.buf = collections.deque(maxlen=buffer_logs)
        self.head = None
        self.head_at = 0.0
        self.last_poll = time.monotonic()
        self.failed_at = 0.0
        self.waiters = 0
        self.bytes_day = 0
        self.dropped = ""             # why the feed removed it, for the callers still waiting


class Chain(threading.Thread):
    def __init__(self, feed, name, url):
        super().__init__(daemon=True, name=f"feed-{name}")
        self.feed, self.chain, self.url = feed, name, url
        self.subs = {}
        self.pending = {}             # request id -> sub key
        self.by_id = {}               # upstream subscription id -> sub key
        self.out = collections.deque()
        self.next_id = 1
        self.status, self.error = "idle", ""
        self.bytes_day = 0
        self.connects = 0
        self.wake_r, self.wake_w = socket.socketpair()
        self.wake_r.setblocking(False)

    def wake(self):
        try:
            self.wake_w.send(b"x")
        except OSError:
            pass

    # every method below that touches subs runs with feed.cond held
    def drop(self, sub, why):
        self.subs.pop(sub.key, None)
        sub.dropped = why
        if sub.sub_id is not None:
            self.by_id.pop(sub.sub_id, None)
            self.out.append(json.dumps({"jsonrpc": "2.0", "id": 0, "method": "eth_unsubscribe",
                                        "params": [sub.sub_id]}))

    def housekeeping(self, now):
        f = self.feed
        if f.exhausted():
            for s in list(self.subs.values()):
                self.drop(s, "the feed's daily CU budget is used up")
        for s in list(self.subs.values()):
            if s.state == "failed" and now - s.failed_at > 20:
                self.drop(s, s.error)
            elif s.waiters == 0 and now - s.last_poll > f.cfg["idle_unsubscribe_s"]:
                self.drop(s, "idle")
        f.cond.notify_all()

    def run(self):
        f, backoff = self.feed, 1.0
        while True:
            with f.cond:
                self.housekeeping(time.monotonic())
                self.out.clear()
                if not self.subs:
                    self.status = "idle"
                    f.cond.wait(5)
                    continue
            try:
                ws = WS(self.url)
            except Exception as exc:               # noqa: BLE001 - DNS, TLS, refusal: all "down"
                with f.cond:
                    self.status, self.error = "down", f.clean(f"cannot connect: {exc}")
                    f.cond.notify_all()
                say(f"{self.chain}: {self.error}; retry in {backoff:.0f} s")
                time.sleep(backoff)
                backoff = min(30.0, backoff * 2)
                continue
            backoff = 1.0
            with f.cond:
                self.status, self.error = "up", ""
                self.connects += 1
                self.pending, self.by_id = {}, {}
                self.out.clear()
                for s in self.subs.values():
                    if s.state != "failed":
                        s.state, s.sub_id = "new", None
            say(f"{self.chain}: connected")
            why = "no subscriptions left"
            try:
                self.io_loop(ws)
            except Exception as exc:               # noqa: BLE001
                why = f.clean(str(exc) or repr(exc))
            ws.close()
            with f.cond:
                # "reconnecting", not "down": callers keep waiting and get "gap" once the stream is back.
                # Only a failed connect (above) answers them with 503.
                self.status = "idle" if not self.subs else "reconnecting"
                self.error = "" if not self.subs else why
                for s in self.subs.values():
                    if s.state != "failed":
                        s.state, s.sub_id = "new", None
                f.cond.notify_all()
            say(f"{self.chain}: disconnected ({why})")

    def io_loop(self, ws):
        f = self.feed
        last_rx = last_ping = time.monotonic()
        while True:
            now = time.monotonic()
            with f.cond:
                self.housekeeping(now)
                for s in self.subs.values():
                    if s.state == "new":
                        rid, self.next_id = self.next_id, self.next_id + 1
                        self.pending[rid] = s.key
                        s.state = "pending"
                        self.out.append(json.dumps({"jsonrpc": "2.0", "id": rid, "method": "eth_subscribe",
                                                    "params": s.params}))
                msgs = list(self.out)
                self.out.clear()
                if not self.subs and not msgs:
                    return
            for m in msgs:
                ws.send_text(m)
            if now - last_ping > 25:
                # a ping frame and a free JSON-RPC call: either answer proves the connection is alive
                ws.ping()
                ws.send_text('{"jsonrpc":"2.0","id":0,"method":"eth_chainId","params":[]}')
                last_ping = now
            if now - last_rx > 75:
                raise WSError("no data for 75 s")
            if ws.read(1.0, self.wake_r):
                last_rx = time.monotonic()
            while True:
                msg = ws.next_message()
                if msg is None:
                    break
                op, payload = msg
                if op == 0x9:
                    ws.pong(payload)
                elif op == 0x8:
                    raise WSError("closed by the server")
                elif op == 0x1:
                    self.on_text(payload)

    def on_text(self, payload):
        f, n = self.feed, len(payload)
        try:
            m = json.loads(payload)
        except ValueError:
            return
        if not isinstance(m, dict):
            return
        now = time.monotonic()
        with f.cond:
            f.account(self, n)
            rid = m.get("id")
            if rid in self.pending:
                key = self.pending.pop(rid)
                s = self.subs.get(key)
                if "error" in m or not isinstance(m.get("result"), str):
                    if s is not None:
                        err = (m.get("error") or {}).get("message", "subscription refused")
                        s.state, s.error, s.failed_at = "failed", f.clean(str(err)), now
                elif s is None:                     # dropped while the request was in flight
                    self.out.append(json.dumps({"jsonrpc": "2.0", "id": 0, "method": "eth_unsubscribe",
                                                "params": [m["result"]]}))
                else:
                    s.sub_id, s.state, s.error = m["result"], "active", ""
                    self.by_id[s.sub_id] = key
                    s.epoch, s.seq = f.new_epoch(), 0
                    s.buf.clear()
            elif m.get("method") == "eth_subscription" and isinstance(m.get("params"), dict):
                s = self.subs.get(self.by_id.get(m["params"].get("subscription")))
                res = m["params"].get("result")
                if s is not None and isinstance(res, dict):
                    s.bytes_day += n
                    s.seq += 1
                    if s.kind == "heads":
                        try:
                            s.head = {"number": int(res["number"], 16), "hash": res.get("hash"),
                                      "parentHash": res.get("parentHash"),
                                      "timestamp": int(res.get("timestamp", "0x0"), 16),
                                      "baseFeePerGas": res.get("baseFeePerGas")}
                            s.head_at = now
                        except (KeyError, ValueError, TypeError):
                            pass
                    else:
                        s.buf.append((s.seq, res))
                        if s.bytes_day * CU_PER_BYTE > f.cfg["per_filter_daily_cu"]:
                            f.blocked[s.key] = utc_day()
                            self.drop(s, "this filter passed its daily CU cap")
                            say(f"{self.chain}: log filter dropped for today, {s.bytes_day} bytes "
                                f"(cap {f.cfg['per_filter_daily_cu']} CU): {s.params[1]}")
            f.cond.notify_all()


class Refuse(Exception):
    def __init__(self, code, message, **extra):
        super().__init__(message)
        self.code, self.body = code, dict(error=message, **extra)


class Feed:
    def __init__(self, cfg, urls, secret=""):
        self.cfg = dict(DEFAULTS, **cfg)
        self.secret = secret
        self.cond = threading.Condition()
        self.day = utc_day()
        self.bytes_day = 0
        self.exhausted_day = ""
        self.blocked = {}             # sub key -> UTC day it passed its cap
        self.epoch = int(time.time())
        self.waiters = 0
        self.started = time.time()
        self.chains = {name: Chain(self, name, url) for name, url in urls.items()}
        for c in self.chains.values():
            c.start()

    def clean(self, text):
        text = " ".join(str(text).split())[:300]
        return text.replace(self.secret, "<key>") if self.secret else text

    def new_epoch(self):
        self.epoch += 1
        return self.epoch

    def roll_day(self):
        today = utc_day()
        if today != self.day:
            say(f"{self.day}: {self.bytes_day} bytes = {self.bytes_day * CU_PER_BYTE:.0f} CU")
            self.day, self.bytes_day = today, 0
            for c in self.chains.values():
                c.bytes_day = 0
                for s in c.subs.values():
                    s.bytes_day = 0
            self.blocked = {k: d for k, d in self.blocked.items() if d == today}

    def exhausted(self):
        self.roll_day()
        return self.exhausted_day == self.day

    def account(self, chain, n):
        self.roll_day()
        self.bytes_day += n
        chain.bytes_day += n
        if self.bytes_day * CU_PER_BYTE > self.cfg["daily_cu_budget"] and self.exhausted_day != self.day:
            self.exhausted_day = self.day
            say(f"daily CU budget used up ({self.bytes_day} bytes, budget {self.cfg['daily_cu_budget']} CU): "
                "all subscriptions are dropped until the next UTC day")

    # --- callers (HTTP threads) ---------------------------------------------------------------
    def chain(self, name):
        c = self.chains.get(name)
        if c is None:
            raise Refuse(404, f"unknown chain {name!r}", chains=sorted(self.chains))
        return c

    def subscribe(self, c, key, kind, params):
        """Find or create the subscription. Called with self.cond held."""
        if self.exhausted():
            raise Refuse(429, "the feed's daily CU budget is used up; poll the relay until the next UTC day")
        if self.blocked.get(key) == self.day:
            raise Refuse(429, "this filter passed its daily CU cap; narrow it, or poll the relay")
        if self.waiters >= self.cfg["max_waiters"]:
            raise Refuse(429, "too many callers are waiting on the feed")
        s = c.subs.get(key)
        if s is None:
            if kind == "logs" and sum(1 for x in c.subs.values() if x.kind == "logs") >= \
                    self.cfg["max_log_filters_per_chain"]:
                raise Refuse(429, f"{c.chain} already has {self.cfg['max_log_filters_per_chain']} log filters; "
                                  "share one filter (several addresses) or poll the relay")
            s = c.subs[key] = Sub(key, kind, params, self.cfg["buffer_logs"])
            self.cond.notify_all()
            c.wake()
        return s

    def wait(self, c, s, timeout, ready):
        """Long-poll: call ready() under the lock until it returns a body, the sub fails, or time is up."""
        deadline = time.monotonic() + timeout
        s.waiters += 1
        self.waiters += 1
        try:
            while True:
                s.last_poll = time.monotonic()
                if c.subs.get(s.key) is not s:
                    raise Refuse(429 if "CU" in s.dropped else 503,
                                 f"subscription dropped: {s.dropped or 'unknown reason'}")
                if s.state == "failed":
                    raise Refuse(503, f"{c.chain} refused the subscription: {s.error}")
                if s.state != "active" and c.status == "down" and c.error:
                    raise Refuse(503, f"{c.chain} feed is down: {c.error}")
                body = ready()
                if body is not None:
                    return body
                left = deadline - time.monotonic()
                if left <= 0:
                    return None
                self.cond.wait(min(left, 1.0))
        finally:
            s.waiters -= 1
            self.waiters -= 1
            s.last_poll = time.monotonic()

    def timeout_of(self, q):
        try:
            t = float(q.get("timeout", ["30"])[0])
        except ValueError:
            raise Refuse(400, "timeout must be a number of seconds") from None
        return max(0.0, min(t, float(self.cfg["max_wait_s"])))

    def head(self, name, q):
        c = self.chain(name)
        if name not in self.cfg["heads"]:
            raise Refuse(400, f"/head is not offered on {name} (every block costs CU; offered on: "
                              f"{', '.join(self.cfg['heads']) or 'no chain'}). Wait for the event you need "
                              "with /logs, or poll the relay.")
        after = None
        if "after" in q:
            try:
                after = int(q["after"][0], 0)
            except ValueError:
                raise Refuse(400, "after must be a block number") from None
        timeout = self.timeout_of(q)
        with self.cond:
            s = self.subscribe(c, ("heads",), "heads", ["newHeads"])

            def ready():
                h = s.head
                if h is None or s.state != "active":
                    return None
                if after is not None and h["number"] <= after:
                    return None
                return dict(h, chain=name, epoch=s.epoch, age_ms=int((time.monotonic() - s.head_at) * 1000))
            body = self.wait(c, s, timeout, ready)
            if body is None:
                body = {"timeout": True, "chain": name, "number": s.head["number"] if s.head else None}
            return body

    def logs(self, name, q):
        c = self.chain(name)
        addrs = [a for a in ",".join(q.get("address", [])).split(",") if a]
        if not addrs or not all(ADDR_RE.match(a) for a in addrs):
            raise Refuse(400, "address=<0x..40 hex>[,<0x..>] is required (a filter without an address "
                              "would deliver every log on the chain)")
        if len(addrs) > self.cfg["max_addresses_per_filter"]:
            raise Refuse(400, f"at most {self.cfg['max_addresses_per_filter']} addresses per filter")
        topics = []
        for i in range(4):
            vals = [t.lower() for t in ",".join(q.get(f"topic{i}", [])).split(",") if t]
            if not all(TOPIC_RE.match(t) for t in vals) or len(vals) > 4:
                raise Refuse(400, f"topic{i} must be 0x + 64 hex (up to 4, comma separated)")
            topics.append(vals)
        if not topics[0]:
            raise Refuse(400, "topic0=<event signature hash> is required")
        while topics and not topics[-1]:
            topics.pop()
        addrs = sorted({a.lower() for a in addrs})
        key = ("logs", tuple(addrs), tuple(tuple(t) for t in topics))
        flt = {"address": addrs, "topics": [(t[0] if len(t) == 1 else t) if t else None for t in topics]}
        after = q.get("after", [None])[0]
        want = None
        if after is not None:
            try:
                e, _, n = after.partition(".")
                want = (int(e), int(n))
            except ValueError:
                raise Refuse(400, "after must be a cursor returned by /logs") from None
        timeout = self.timeout_of(q)
        with self.cond:
            s = self.subscribe(c, key, "logs", ["logs", flt])

            def cursor():
                return f"{s.epoch}.{s.seq}"

            def ready():
                if s.state != "active":
                    return None
                if want is None:
                    return {"chain": name, "cursor": cursor(), "logs": []}
                oldest = s.buf[0][0] if s.buf else s.seq + 1
                if want[0] != s.epoch or want[1] > s.seq or want[1] + 1 < oldest:
                    return {"chain": name, "cursor": cursor(), "logs": [], "gap": True}
                if s.seq > want[1]:
                    return {"chain": name, "cursor": cursor(), "logs": [l for n, l in s.buf if n > want[1]]}
                return None
            body = self.wait(c, s, timeout, ready)
            if body is None:
                if want is None:
                    raise Refuse(503, f"{name}: the subscription was not confirmed within {timeout:.0f} s")
                body = {"timeout": True, "chain": name, "cursor": after, "logs": []}
            return body

    def health(self):
        with self.cond:
            self.roll_day()
            now = time.monotonic()
            chains = {}
            for name, c in sorted(self.chains.items()):
                subs = []
                for s in c.subs.values():
                    d = {"kind": s.kind, "state": s.state, "waiters": s.waiters,
                         "idle_s": int(now - s.last_poll), "cu_today": round(s.bytes_day * CU_PER_BYTE)}
                    if s.kind == "heads":
                        d["head"] = s.head["number"] if s.head else None
                        d["head_age_s"] = round(now - s.head_at, 1) if s.head else None
                    else:
                        d["filter"] = s.params[1]
                    if s.error:
                        d["error"] = s.error
                    subs.append(d)
                chains[name] = {"status": c.status, "connects": c.connects,
                                "cu_today": round(c.bytes_day * CU_PER_BYTE), "subscriptions": subs}
                if c.error:
                    chains[name]["error"] = c.error
            return {"ok": True, "day": self.day, "cu_today": round(self.bytes_day * CU_PER_BYTE),
                    "daily_cu_budget": self.cfg["daily_cu_budget"], "exhausted": self.exhausted_day == self.day,
                    "heads_offered_on": self.cfg["heads"], "blocked_filters_today": len(self.blocked),
                    "uptime_s": int(time.time() - self.started), "chains": chains}


class Handler(http.server.BaseHTTPRequestHandler):
    feed = None
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def send_json(self, code, obj):
        data = json.dumps(obj, separators=(",", ":")).encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except OSError:
            pass                                   # the caller went away during the long-poll

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        parts = [p for p in u.path.split("/") if p]
        q = urllib.parse.parse_qs(u.query)
        try:
            if parts == ["health"]:
                return self.send_json(200, self.feed.health())
            if len(parts) == 2 and parts[0] == "head":
                return self.send_json(200, self.feed.head(parts[1], q))
            if len(parts) == 2 and parts[0] == "logs":
                return self.send_json(200, self.feed.logs(parts[1], q))
            self.send_json(404, {"error": "use GET /head/<chain>, /logs/<chain> or /health"})
        except Refuse as r:
            self.send_json(r.code, r.body)
        except Exception as exc:                   # noqa: BLE001 - never die on a caller's input
            say(f"internal error: {self.feed.clean(repr(exc))}")
            self.send_json(500, {"error": "internal error"})


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 64


def load():
    cfg = {}
    try:
        with open(FEED_CONFIG, encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        pass
    cfg = dict(DEFAULTS, **cfg)
    with open(RELAY_CONFIG, encoding="utf-8") as f:
        relay = json.load(f)
    with open(KEY_PATH, encoding="utf-8") as f:
        key = f.read().strip()
    if not key:
        raise SystemExit(f"farm-feed: {KEY_PATH} is empty")
    urls = {name: cfg["ws_url"].format(slug=spec["alchemy"], key=key)
            for name, spec in relay["chains"].items() if spec.get("alchemy")}
    only = cfg.get("chains")
    if only:
        urls = {n: u for n, u in urls.items() if n in only}
    return cfg, urls, key


def check(chain, url, secret, limit=45):
    """Connect, take one head, report its size. Costs one notification (about 55 CU)."""
    t0 = time.monotonic()
    try:
        ws = WS(url)
        ws.send_text(json.dumps({"jsonrpc": "2.0", "id": 1, "method": "eth_subscribe", "params": ["newHeads"]}))
        sub = None
        while time.monotonic() - t0 < limit:
            ws.read(1.0)
            while True:
                msg = ws.next_message()
                if msg is None:
                    break
                op, payload = msg
                if op == 0x9:
                    ws.pong(payload)
                    continue
                if op != 0x1:
                    continue
                m = json.loads(payload)
                if m.get("id") == 1:
                    if "error" in m:
                        raise WSError(f"eth_subscribe refused: {m['error'].get('message')}")
                    sub = m["result"]
                elif m.get("method") == "eth_subscription":
                    n = len(payload)
                    num = int(m["params"]["result"]["number"], 16)
                    ws.send_text(json.dumps({"jsonrpc": "2.0", "id": 2, "method": "eth_unsubscribe", "params": [sub]}))
                    ws.close()
                    print(f"farm-feed check: {chain} head {num} after {time.monotonic() - t0:.1f} s, "
                          f"{n} bytes = {n * CU_PER_BYTE:.1f} CU per head")
                    return 0
        raise WSError(f"no head within {limit} s")
    except Exception as exc:                       # noqa: BLE001
        text = " ".join(str(exc).split())[:300]
        print(f"farm-feed check: {chain} FAILED: {text.replace(secret, '<key>') if secret else text}", file=sys.stderr)
        return 1


def main(argv):
    cfg, urls, key = load()
    if argv and argv[0] == "--check":
        chain = argv[1] if len(argv) > 1 else "ethereum"
        if chain not in urls:
            raise SystemExit(f"farm-feed: no Alchemy endpoint for {chain!r} in {RELAY_CONFIG}")
        return check(chain, urls[chain], key)
    if argv:
        raise SystemExit(__doc__)
    Handler.feed = Feed(cfg, urls, key)
    bind = (cfg["bind"], int(cfg["port"]))
    say(f"listening on {bind[0]}:{bind[1]} chains={sorted(urls)} heads={cfg['heads']} "
        f"budget={cfg['daily_cu_budget']} CU/day")
    Server(bind, Handler).serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
