#!/usr/bin/env python3
"""Paper runner CLI for agents.

  paper list                          paper bots and their service state
  paper status <id>                   service state, uptime, restarts, last log lines
  paper logs <id> [--lines N]         bot output (journal), newest last
  paper start <id>                    run bots/paper/<id>/run.sh as a supervised service
  paper stop <id>
  paper restart <id>
  paper archive <id> --reason "<why>" stop and move to bots/archive/<id>/

A paper bot is a directory bots/paper/<id>/ with an executable run.sh and a
manifest.yaml. It runs as user farmbot with RPC_RELAY_URL and RPC_LANE=paper
in its environment, with the bot directory as its working directory. It may
write only under logs/ and state/ inside its own directory. In paper mode it
must not send transactions (and it has no key to do so).
"""
import os
import re
import subprocess
import sys

WS = "/srv/farm/ws"
PAPER = f"{WS}/bots/paper"
CTL = "/opt/farm/bin/paper-ctl"
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,47}$")


def die(msg):
    print(f"paper: {msg}", file=sys.stderr)
    sys.exit(2)


def check_id(bot_id):
    if not ID_RE.match(bot_id):
        die("bot id must be 3-48 chars of lowercase letters, digits and '-'")
    return bot_id


def unit_state(bot_id):
    r = subprocess.run(["systemctl", "show", f"paper@{bot_id}.service", "-p", "ActiveState,SubState,NRestarts,ExecMainStartTimestamp"],
                       capture_output=True, text=True, check=False)
    return dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)


def cmd_list():
    if not os.path.isdir(PAPER):
        return
    print("id\tstate\trestarts\tsince")
    for bot_id in sorted(os.listdir(PAPER)):
        if not ID_RE.match(bot_id):
            continue
        st = unit_state(bot_id)
        print(f"{bot_id}\t{st.get('ActiveState','?')}/{st.get('SubState','?')}\t{st.get('NRestarts','0')}\t{st.get('ExecMainStartTimestamp','')}")


def cmd_status(bot_id):
    st = unit_state(bot_id)
    for k, v in st.items():
        print(f"{k}: {v}")
    print("--- last 20 lines ---")
    cmd_logs(bot_id, 20)


def cmd_logs(bot_id, lines):
    r = subprocess.run(["journalctl", "-u", f"paper@{bot_id}.service", "-n", str(lines), "--no-pager", "-o", "short-iso"],
                       capture_output=True, text=True, check=False)
    sys.stdout.write(r.stdout or r.stderr)


def ctl(*args):
    env = {k: v for k, v in os.environ.items() if k in ("FARM_ROLE", "FARM_RUN_ID")}
    cmd = ["sudo", "-n"] + [f"{k}={v}" for k, v in env.items()] + [CTL, *args]
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    sys.exit(r.returncode)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "list" and not rest:
        cmd_list()
    elif cmd == "status" and len(rest) == 1:
        cmd_status(check_id(rest[0]))
    elif cmd == "logs" and rest:
        n = 100
        if len(rest) == 3 and rest[1] == "--lines":
            n = max(1, min(int(rest[2]), 2000))
        elif len(rest) != 1:
            die("usage: paper logs <id> [--lines N]")
        cmd_logs(check_id(rest[0]), n)
    elif cmd in ("start", "stop", "restart") and len(rest) == 1:
        ctl(cmd, check_id(rest[0]))
    elif cmd == "archive" and len(rest) == 3 and rest[1] == "--reason":
        ctl("archive", check_id(rest[0]), rest[2])
    else:
        die("bad arguments; run 'paper help'")


if __name__ == "__main__":
    main(sys.argv[1:])
