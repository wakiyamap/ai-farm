#!/usr/bin/env python3
"""Farm signer: the only process that touches private keys.

Listens on a Unix socket (/run/farm/signer.sock). A live bot sends a JSON
request; the signer identifies the caller from the socket peer credentials and
its cgroup (bot@<id>.service), applies the policy, signs with that bot's
derived key, and broadcasts through the relay's live lane.

Request:  {"op": "send", "chain": "base", "to": "0x..", "data": "0x..", "value": "0x..",
           "gas": "0x..", "maxFeePerGas": "0x..", "maxPriorityFeePerGas": "0x.."}
          {"op": "address"}      -> the caller's own address
          {"op": "limits"}       -> what the policy allows the caller today
Response: {"ok": true, "txHash": "0x.."} or {"ok": false, "error": "..."}

Policy (enforced here, in code):
  - a bot signs only with its own key, only on chains in its manifest
  - `to` must be in the bot's allowed contracts (manifest `allowed_contracts`),
    the intermediate wallet, or a configured USDC token; approve() only to allowed
    contracts, never unlimited; ERC-20 transfer/transferFrom only to allowed
    contracts or the intermediate wallet; USDC moved out counts toward the daily spend
  - value + gas*maxFeePerGas <= L (USD, via cached ETH/USD) per transaction
  - per-bot daily spend <= capital_usd; promotions frozen flag honoured by the gate
Every decision is appended to /var/lib/farmgate/signer.log (JSON lines).
"""
import datetime as dt
import json
import os
import socket
import socketserver
import struct
import sys
import threading
import time
import urllib.request

sys.path[:0] = ["/opt/farm/pylib", "/opt/farm/lib"]
import farmkeys  # noqa: E402
import re  # noqa: E402


def manifest_block(text, key):
    """Lines of a top-level manifest key: the value on its own line plus every following indented
    line, comments stripped. Tolerates inline lists, block lists and lists of mappings."""
    out, inside = [], False
    for raw in text.splitlines():
        line = raw.split(" #", 1)[0].rstrip() if not raw.lstrip().startswith("#") else ""
        if not line.strip():
            continue
        if not line[0].isspace() and not line.startswith("-"):
            inside = line.split(":", 1)[0].strip() == key
            if inside:
                out.append(line.split(":", 1)[1] if ":" in line else "")
            continue
        if inside:
            out.append(line)
    return out


def manifest_addresses(text, key="allowed_contracts"):
    seen = []
    for line in manifest_block(text, key):
        for a in re.findall(r"0x[0-9a-fA-F]{40}(?![0-9a-fA-F])", line):
            if a.lower() not in seen:
                seen.append(a.lower())
    return seen


def manifest_list(text, key):
    vals = []
    for line in manifest_block(text, key):
        s = line.strip()
        if s.startswith("["):
            vals += [v.strip().strip("'\"") for v in s.strip("[]").split(",") if v.strip()]
        elif s.startswith("- "):
            vals.append(s[2:].strip().strip("'\""))
        elif s and not vals and "," not in s:
            vals.append(s.strip("'\""))
    return vals

SOCK = "/run/farm/signer.sock"
CONF = "/etc/farm/gate.json"
STATE = "/var/lib/farmgate"
LOG = f"{STATE}/signer.log"
LIVE_DIR = "/srv/farm/ws/bots/live"

# chain ids, Chainlink native/USD feeds (8 decimals), USDC decimals, gas limits: farmchains (10b)
from farmchains import CHAIN_IDS, ETH_USD_FEED, CORE, usdc_scale, price_ok, desc_ok, native, max_tx_gas  # noqa: E402
from farmchains import feed_chain  # noqa: E402  (10g: elysium is priced with the feed on hyperevm)
SEL_APPROVE = farmkeys.selector("approve(address,uint256)")
SEL_TRANSFER = farmkeys.selector("transfer(address,uint256)")
SEL_TRANSFER_FROM = farmkeys.selector("transferFrom(address,address,uint256)")
SEL_INCREASE_ALLOWANCE = farmkeys.selector("increaseAllowance(address,uint256)")
UNLIMITED = (1 << 256) - 1


def now():
    return dt.datetime.now(dt.timezone.utc)


def log(**rec):
    rec["at"] = now().isoformat(timespec="seconds")
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")


class Rpc:
    """Reads over http (8545); sends over the farmgate-only unix socket."""
    SEND_SOCK = "/run/farm-relay/send.sock"

    def __init__(self, url):
        self.url = url

    def call(self, chain, method, params, lane="live"):
        body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
        if method == "eth_sendRawTransaction":
            out = self._unix(f"/{chain}?lane={lane}", body)
        else:
            req = urllib.request.Request(f"{self.url}/{chain}?lane={lane}", data=body,
                                         headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=30) as r:
                out = json.loads(r.read())
        if "error" in out:
            raise RuntimeError(out["error"].get("message", "rpc error"))
        return out["result"]

    def _unix(self, path, body):
        import http.client
        import socket as _s

        class Conn(http.client.HTTPConnection):
            def connect(self):
                self.sock = _s.socket(_s.AF_UNIX, _s.SOCK_STREAM)
                self.sock.settimeout(30)
                self.sock.connect(Rpc.SEND_SOCK)
        c = Conn("unix")
        c.request("POST", path, body=body, headers={"Content-Type": "application/json", "Content-Length": str(len(body))})
        r = c.getresponse()
        return json.loads(r.read())


class Prices:
    def __init__(self, rpc):
        self.rpc, self.cache = rpc, {}

    def verify_feeds(self):
        """Every feed must be an 8-decimal native/USD aggregator with the expected description
        (farmchains). A bad feed on an original chain stops the signer, as before; on a chain added
        in phase 10 it disables signing on that chain only (logged), so one new chain's RPC trouble
        at start cannot stop every live bot."""
        self.disabled = {}
        for chain, feed in ETH_USD_FEED.items():
            try:
                dec = int(self.rpc.call(feed_chain(chain), "eth_call", [{"to": feed, "data": farmkeys.selector("decimals()")}, "latest"]), 16)
                raw = self.rpc.call(feed_chain(chain), "eth_call", [{"to": feed, "data": farmkeys.selector("description()")}, "latest"])
                b = bytes.fromhex(raw[2:])
                desc = b[64:64 + int.from_bytes(b[32:64], "big")].decode("utf-8", "replace") if len(b) >= 64 else ""
                ok, why = dec == 8 and desc_ok(chain, desc), f"decimals={dec}, description={desc!r}"
            except Exception as exc:                       # noqa: BLE001 - any failure means unverified
                ok, why = False, f"read failed: {exc}"
            if ok:
                continue
            if chain in CORE:
                raise SystemExit(f"farm-signer: {chain} feed {feed} is not {native(chain)}/USD ({why})")
            self.disabled[chain] = why
            log(op="chain_disabled", chain=chain, feed=feed, why=why)
            print(f"farm-signer: {chain} disabled, feed {feed} not verified ({why})", file=sys.stderr)

    def eth_usd(self, chain):
        c = self.cache.get(chain)
        if c and c[0] > time.monotonic():
            return c[1]
        data = farmkeys.selector("latestAnswer()")
        res = self.rpc.call(feed_chain(chain), "eth_call", [{"to": ETH_USD_FEED[chain], "data": data}, "latest"], lane="live")
        price = int(res, 16) / 1e8
        if not price_ok(chain, price):
            raise RuntimeError(f"implausible {native(chain)}/USD price {price} on {chain}")
        self.cache[chain] = (time.monotonic() + 60, price)
        return price


class Signer:
    def __init__(self):
        with open(CONF, encoding="utf-8") as f:
            self.cfg = json.load(f)
        self.master = farmkeys.load_master()
        self.rpc = Rpc(self.cfg["relay_url"])
        self.prices = Prices(self.rpc)
        self.prices.verify_feeds()
        self.lock = threading.Lock()
        self.spend_path = f"{STATE}/spend.json"   # {"day": "...", "bots": {id: usd}}

    # --- caller identity -------------------------------------------------
    @staticmethod
    def caller_bot(conn):
        creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        pid, uid, _gid = struct.unpack("3i", creds)
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as f:
            cg = f.read()
        for line in cg.splitlines():
            if "/bot@" in line and line.rstrip().endswith(".service"):
                unit = line.rsplit("/", 1)[-1]
                return unit[len("bot@"):-len(".service")], uid
        return None, uid

    def manifest(self, bot_id):
        with open(f"{LIVE_DIR}/{bot_id}/manifest.yaml", encoding="utf-8") as f:
            text = f.read()
        m = {"allowed_contracts": manifest_addresses(text), "chains": manifest_list(text, "chains"),
             "capital_usd": 0}
        cap = manifest_list(text, "capital_usd")
        if cap:
            m["capital_usd"] = float(cap[0])
        # executor contracts deployed by the gate are always callable
        try:
            with open(f"{LIVE_DIR}/{bot_id}/state/executor.json", encoding="utf-8") as f:
                for v in json.load(f).values():
                    m["allowed_contracts"].append(v["address"].lower())
        except (OSError, ValueError, KeyError, AttributeError):
            pass
        return m

    # --- spend ledger ----------------------------------------------------
    def spend(self):
        day = now().strftime("%Y-%m-%d")
        try:
            with open(self.spend_path, encoding="utf-8") as f:
                s = json.load(f)
        except (OSError, ValueError):
            s = {}
        if s.get("day") != day:
            s = {"day": day, "bots": {}}
        return s

    def add_spend(self, bot_id, usd):
        s = self.spend()
        s["bots"][bot_id] = s["bots"].get(bot_id, 0.0) + usd
        tmp = self.spend_path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(s, f)
        os.replace(tmp, self.spend_path)

    # --- policy ----------------------------------------------------------
    def check(self, bot_id, req, m, bot_addr):
        chain = req.get("chain")
        if chain not in CHAIN_IDS or chain not in m["chains"]:
            return f"chain {chain} not allowed for {bot_id}"
        if chain in getattr(self.prices, "disabled", {}):
            return (f"{chain} is disabled: its price feed was not verified when the signer started "
                    f"({self.prices.disabled[chain]}); restart farm-signer once the relay reads it")
        to = (req.get("to") or "").lower()
        inter = farmkeys.address_of(farmkeys.derive_private_key(self.master, "intermediate")).lower()
        data = (req.get("data") or "0x").lower()
        usdc_tokens = {(self.cfg.get("usdc") or {}).get(chain, "").lower()} - {""}   # this chain's only (10b)
        if to not in m["allowed_contracts"] and to != inter and to not in usdc_tokens:
            return f"to {to} is not in allowed_contracts"
        transferred_usd = 0.0
        if data.startswith(SEL_TRANSFER) or data.startswith(SEL_TRANSFER_FROM):
            # token leaving the wallet: the recipient must be a place the policy allows,
            # otherwise `transfer` on an allowed token would bypass allowed_contracts.
            if data.startswith(SEL_TRANSFER):
                dest = "0x" + data[34:74]
                amount = int(data[74:138], 16) if len(data) >= 138 else 0
            else:
                dest = "0x" + data[98:138]
                amount = int(data[138:202], 16) if len(data) >= 202 else 0
            if dest not in m["allowed_contracts"] and dest != inter:
                return f"token transfer to {dest} is not allowed (allowed_contracts or the intermediate wallet only)"
            if to in usdc_tokens:
                transferred_usd = amount / usdc_scale(chain)
        # increaseAllowance(spender, amount) grants an allowance exactly like approve; USDC has it,
        # and until 10e it passed unchecked, to any spender and for any amount
        if data.startswith(SEL_APPROVE) or data.startswith(SEL_INCREASE_ALLOWANCE):
            spender = "0x" + data[34:74]
            amount = int(data[74:138], 16) if len(data) >= 138 else 0
            if spender not in m["allowed_contracts"]:
                return f"approve spender {spender} not allowed"
            if amount >= UNLIMITED // 2:
                return "unlimited approve is not allowed"
        try:
            gas, fee = int(req["gas"], 16), int(req["maxFeePerGas"], 16)
            value = int(req.get("value", "0x0"), 16)
        except (KeyError, ValueError, TypeError):
            return "gas, maxFeePerGas and value must be hex strings"
        if gas > max_tx_gas(chain):
            return (f"gas limit above {max_tx_gas(chain):,} on {chain}"
                    + (" (larger transactions only land in big blocks, which farm keys do not use)" if chain == "hyperevm" else ""))
        price = self.prices.eth_usd(chain)
        worst_usd = (value + gas * fee) / 1e18 * price
        if worst_usd > self.cfg["max_loss_per_tx_usd"]:
            return f"worst case {worst_usd:.2f} USD exceeds L={self.cfg['max_loss_per_tx_usd']}"
        cap = (self.cfg.get("gas_wallet_cap_usd") or {}).get(chain)
        if cap is not None:
            # OP Stack: L1 data / operator fees are not bounded by the tx fields, so the
            # enforceable worst case is the wallet's native balance; keep it under the cap.
            bal_usd = int(self.rpc.call(chain, "eth_getBalance", [bot_addr, "latest"]), 16) / 1e18 * price
            if bal_usd > cap:
                return f"native balance {bal_usd:.2f} USD on {chain} is above the gas wallet cap {cap} USD (unexpected inflow? sweep first)"
        spent = self.spend()["bots"].get(bot_id, 0.0)
        if spent + worst_usd + transferred_usd > m["capital_usd"]:
            return f"daily spend {spent + worst_usd + transferred_usd:.2f} would exceed capital_usd {m['capital_usd']}"
        if os.path.exists(f"{STATE}/halt"):
            return "signer halted (gate stop --all)"
        return None

    # --- ops -------------------------------------------------------------
    def handle(self, conn, req):
        bot_id, uid = self.caller_bot(conn)
        if not bot_id:
            return {"ok": False, "error": "caller is not a bot@ service"}
        try:
            priv = farmkeys.derive_private_key(self.master, f"bot:{bot_id}")
        except KeyError:
            return {"ok": False, "error": f"{bot_id} has no account (not promoted by the gate)"}
        addr = farmkeys.address_of(priv)
        op = req.get("op")
        if op == "address":
            return {"ok": True, "address": farmkeys.checksum(addr)}
        try:
            m = self.manifest(bot_id)
        except OSError:
            return {"ok": False, "error": f"{bot_id} is not live"}
        if op == "limits":
            return {"ok": True, "chains": m["chains"], "allowed_contracts": m["allowed_contracts"],
                    "max_loss_per_tx_usd": self.cfg["max_loss_per_tx_usd"], "capital_usd": m["capital_usd"],
                    "gas_wallet_cap_usd": self.cfg.get("gas_wallet_cap_usd", {}),
                    "spent_today_usd": self.spend()["bots"].get(bot_id, 0.0)}
        if op != "send":
            return {"ok": False, "error": "unknown op"}
        with self.lock:
            why = self.check(bot_id, req, m, addr)
            if why:
                log(bot=bot_id, op="send", decision="reject", why=why, chain=req.get("chain"), to=req.get("to"))
                return {"ok": False, "error": why}
            chain = req["chain"]
            nonce = int(self.rpc.call(chain, "eth_getTransactionCount", [addr, "pending"]), 16)
            tx = {"chainId": CHAIN_IDS[chain], "nonce": nonce, "to": req["to"], "value": req.get("value", "0x0"),
                  "data": req.get("data", "0x"), "gas": req["gas"], "maxFeePerGas": req["maxFeePerGas"],
                  "maxPriorityFeePerGas": req.get("maxPriorityFeePerGas", req["maxFeePerGas"])}
            raw = farmkeys.sign_eip1559(priv, tx)
            try:
                h = self.rpc.call(chain, "eth_sendRawTransaction", ["0x" + raw.hex()])
            except Exception as exc:                  # noqa: BLE001 - socket errors and timeouts too (10e):
                # the transaction may be out all the same, and the watchdog halts everything on a
                # bot nonce it finds in no log
                log(bot=bot_id, op="send", decision="broadcast_failed", why=str(exc) or repr(exc), chain=chain, nonce=nonce)
                return {"ok": False, "error": f"broadcast failed: {exc}"}
            worst = (int(tx["value"], 16) + int(tx["gas"], 16) * int(tx["maxFeePerGas"], 16)) / 1e18 * self.prices.eth_usd(chain)
            d = (req.get("data") or "0x").lower()
            if req["to"].lower() == (self.cfg.get("usdc") or {}).get(chain, "").lower() and d.startswith(SEL_TRANSFER):
                worst += (int(d[74:138], 16) if len(d) >= 138 else 0) / usdc_scale(chain)
            self.add_spend(bot_id, worst)
            log(bot=bot_id, op="send", decision="sent", chain=chain, nonce=nonce, to=req["to"], txHash=h, worst_usd=round(worst, 4))
            return {"ok": True, "txHash": h, "nonce": nonce}


class Handler(socketserver.StreamRequestHandler):
    signer = None

    def handle(self):
        try:
            line = self.rfile.readline(65536)
            req = json.loads(line)
            resp = self.signer.handle(self.connection, req)
        except (ValueError, OSError) as exc:
            resp = {"ok": False, "error": f"bad request: {exc}"}
        except Exception as exc:  # never die on a bot's input
            log(op="error", why=repr(exc))
            resp = {"ok": False, "error": "internal error"}
        self.wfile.write((json.dumps(resp) + "\n").encode())


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def main():
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    Handler.signer = Signer()
    srv = Server(SOCK, Handler)
    os.chmod(SOCK, 0o660)   # group farmbot may connect; set by the unit via chgrp
    import grp
    try:
        os.chown(SOCK, -1, grp.getgrnam("farmbot").gr_gid)
    except KeyError:
        pass
    log(op="start")
    print("farm-signer: listening on " + SOCK, file=sys.stderr)
    srv.serve_forever()


if __name__ == "__main__":
    main()
