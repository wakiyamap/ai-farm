#!/usr/bin/env python3
"""farm-explorer: a local read-only door to the Etherscan V2 API that keeps the API key.

Agents call it through /opt/farm/bin/explorer; they never see the key. Only a fixed set of
read operations on a known address is passed on. There is no search by name: Etherscan's API
has none.

  GET /health                         counters, per-chain status
  GET /chains[?probe=1]               which configured chains this key can use
  GET /q/<chain>/<op>?address=0x...   op: source | abi | creation | txs | internal | tokentx

Config: /etc/farm/explorer.json (no secrets). Key: $CREDENTIALS_DIRECTORY/key (systemd
LoadCredential from /etc/farm/explorer.key, root 0600). Standard library only.
"""
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = os.environ.get("FARM_EXPLORER_CONF", "/etc/farm/explorer.json")
ADDR_RE = re.compile(r"^0x[0-9a-fA-F]{40}$")

# op -> (module, action, name of the address parameter, cacheable)
OPS = {
    "source": ("contract", "getsourcecode", "address", True),
    "abi": ("contract", "getabi", "address", True),
    "creation": ("contract", "getcontractcreation", "contractaddresses", True),
    "txs": ("account", "txlist", "address", False),
    "internal": ("account", "txlistinternal", "address", False),
    "tokentx": ("account", "tokentx", "address", False),
}
# optional numeric parameters of the list ops: name -> (lowest, highest)
LIST_PARAMS = {"page": (1, 50), "offset": (1, 200), "startblock": (0, 10**12), "endblock": (0, 10**12)}
CACHE_MAX, CACHE_TTL_S = 500, 24 * 3600


class Refused(Exception):
    """A request this service does not pass on. (status, message)"""


class Explorer:
    def __init__(self, cfg, key):
        self.cfg, self.key = cfg, key
        self.chains = dict(cfg["chains"])
        self.lock = threading.Lock()
        self.last_call = 0.0
        self.day, self.calls_today = "", 0
        self.cache = {}                     # (chain, op, address) -> (time, payload)
        self.status = {}                    # chain -> ok | not_on_plan | unsupported | invalid_key | error: ...
        self.probed_at = {}                 # chain -> time of the last probe (plans change: re-probe after 6 h)
        self.stats = {"upstream_ok": 0, "upstream_failed": 0, "cache_hits": 0, "refused": 0}

    # --- upstream -----------------------------------------------------------------------
    def scrub(self, text):
        """The key never leaves this process, whatever the upstream echoes back."""
        return text.replace(self.key, "***") if self.key else text

    def upstream(self, chain, params):
        """One GET to Etherscan. Spaced by min_interval_s and counted against daily_limit."""
        with self.lock:
            today = time.strftime("%Y-%m-%d", time.gmtime())
            if today != self.day:
                self.day, self.calls_today = today, 0
            if self.calls_today >= self.cfg.get("daily_limit", 20000):
                raise Refused((429, f"daily limit of {self.cfg.get('daily_limit', 20000)} explorer calls reached; "
                                    "it resets at 00:00 UTC"))
            wait = self.cfg.get("min_interval_s", 0.4) - (time.monotonic() - self.last_call)
            if wait > 0:
                time.sleep(wait)
            self.last_call = time.monotonic()
            self.calls_today += 1
        q = dict(params, chainid=str(self.chains[chain]), apikey=self.key)
        url = self.cfg["upstream"] + "?" + urllib.parse.urlencode(q)
        t0 = time.monotonic()
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": "farm-explorer/1"})
            with urllib.request.urlopen(req, timeout=self.cfg.get("timeout_s", 20)) as r:
                data = json.loads(r.read(32 * 1024 * 1024))
        except Exception as exc:                                  # noqa: BLE001 - network, HTTP status, bad JSON
            self.stats["upstream_failed"] += 1
            log(chain=chain, action=params.get("action"), ok=False, ms=int((time.monotonic() - t0) * 1000),
                why=self.scrub(repr(exc))[:200])
            raise Refused((502, "explorer upstream failed: " + self.scrub(str(exc) or type(exc).__name__)[:300]))
        self.stats["upstream_ok"] += 1
        log(chain=chain, action=params.get("action"), ok=True, ms=int((time.monotonic() - t0) * 1000))
        return data

    def classify(self, chain, data):
        """Etherscan answers HTTP 200 with status "0" and the reason in `result` or `message`.
        Returns None when the answer is usable, else (status, message); remembers what it
        says about the chain or the key."""
        if not isinstance(data, dict):
            return 502, "explorer upstream returned something that is not a JSON object"
        if "jsonrpc" in data:                                     # the proxy module (probe only)
            if "result" in data:
                self.status[chain] = "ok"
                return None
            text = json.dumps(data.get("error"))
        elif str(data.get("status")) == "1":
            self.status[chain] = "ok"
            return None
        else:
            result = data.get("result")
            text = f"{data.get('message')} {result if isinstance(result, str) else ''}"
            if isinstance(result, list) and not result:           # "No transactions found": a real, empty answer
                self.status[chain] = "ok"
                return None
        text = self.scrub(text).strip()
        low = text.lower()
        if "free api access is not supported" in low or "upgrade your api plan" in low:
            self.status[chain] = "not_on_plan"
            return 402, (f"{chain} is not on this API key's plan (Etherscan: {text[:160]}). Use the chain's own "
                         "explorer or Routescan / Blockscout directly for this chain")
        if "invalid api key" in low or "missing/invalid" in low or "missing or invalid" in low:
            self.status[chain] = "invalid_key"
            return 503, "the explorer API key is missing or invalid; tell the human (inbox/human)"
        if "unsupported chain" in low or "invalid chainid" in low or "chainid" in low and "not supported" in low:
            self.status[chain] = "unsupported"
            return 404, f"Etherscan does not serve {chain} (chain id {self.chains[chain]})"
        if "rate limit" in low:
            return 429, f"Etherscan rate limit: {text[:160]}; wait a few seconds"
        return 422, f"Etherscan: {text[:300]}"                    # e.g. "Contract source code not verified"

    # --- operations ---------------------------------------------------------------------
    def query(self, chain, op, args):
        if chain not in self.chains:
            raise Refused((404, f"unknown chain {chain!r}; known: {', '.join(sorted(self.chains))}"))
        if op not in OPS:
            raise Refused((404, f"unknown operation {op!r}; known: {', '.join(sorted(OPS))}"))
        module, action, addr_param, cacheable = OPS[op]
        address = args.get("address", "")
        if not ADDR_RE.match(address):
            raise Refused((400, "address must be 0x followed by 40 hex digits"))
        params = {"module": module, "action": action, addr_param: address}
        if not cacheable:
            for name, (lo, hi) in LIST_PARAMS.items():
                if name in args:
                    try:
                        v = int(args[name])
                    except ValueError:
                        raise Refused((400, f"{name} must be a whole number"))
                    if not lo <= v <= hi:
                        raise Refused((400, f"{name} must be between {lo} and {hi}"))
                    params[name] = str(v)
            params.setdefault("page", "1")
            params.setdefault("offset", "50")
            params["sort"] = "asc" if args.get("sort") == "asc" else "desc"
            if op == "tokentx" and args.get("contractaddress"):
                if not ADDR_RE.match(args["contractaddress"]):
                    raise Refused((400, "contractaddress must be 0x followed by 40 hex digits"))
                params["contractaddress"] = args["contractaddress"]
        key = (chain, op, address.lower())
        if cacheable:
            hit = self.cache.get(key)
            if hit and time.time() - hit[0] < CACHE_TTL_S:
                self.stats["cache_hits"] += 1
                return hit[1]
        data = self.upstream(chain, params)
        bad = self.classify(chain, data)
        if bad:
            raise Refused(bad)
        out = {"chain": chain, "op": op, "address": address, "result": data.get("result")}
        if cacheable:
            if len(self.cache) >= CACHE_MAX:
                self.cache.pop(min(self.cache, key=lambda k: self.cache[k][0]))
            self.cache[key] = (time.time(), out)
        return out

    def probe(self, chain):
        """Does this key work on this chain? One cheap call (the chain's block number)."""
        self.probed_at[chain] = time.time()
        try:
            data = self.upstream(chain, {"module": "proxy", "action": "eth_blockNumber"})
        except Refused as exc:
            self.status[chain] = "error: " + exc.args[0][1][:120]
            return self.status[chain]
        bad = self.classify(chain, data)
        if bad and self.status.get(chain) in (None, "ok"):
            self.status[chain] = "error: " + bad[1][:120]
        return self.status[chain]

    def chain_table(self, probe=False):
        for chain in sorted(self.chains):
            if probe or chain not in self.status or time.time() - self.probed_at.get(chain, 0) > 6 * 3600:
                self.probe(chain)
        return {c: {"chain_id": self.chains[c], "status": self.status.get(c, "unknown")} for c in sorted(self.chains)}


def log(**kw):
    print(json.dumps(dict(ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **kw)), flush=True)


def make_handler(ex):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):                                # the upstream log line is enough
            pass

        def send(self, status, obj):
            body = json.dumps(obj).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):                                         # noqa: N802
            parsed = urllib.parse.urlparse(self.path)
            args = {k: v[0] for k, v in urllib.parse.parse_qs(parsed.query).items()}
            parts = [p for p in parsed.path.split("/") if p]
            try:
                if parts == ["health"]:
                    return self.send(200, {"ok": True, "day": ex.day, "calls_today": ex.calls_today,
                                           "daily_limit": ex.cfg.get("daily_limit", 20000), "chains": ex.status,
                                           **ex.stats})
                if parts == ["chains"]:
                    return self.send(200, {"chains": ex.chain_table(probe=args.get("probe") == "1")})
                if len(parts) == 3 and parts[0] == "q":
                    return self.send(200, ex.query(parts[1], parts[2], args))
                raise Refused((404, "paths: /health, /chains, /q/<chain>/<op>?address=0x..."))
            except Refused as exc:
                ex.stats["refused"] += 1
                status, why = exc.args[0]
                return self.send(status, {"error": why})
            except Exception as exc:                              # noqa: BLE001 - never a traceback with the key in it
                return self.send(500, {"error": "farm-explorer internal error: " + ex.scrub(repr(exc))[:200]})

        def do_POST(self):                                        # noqa: N802
            self.send(405, {"error": "read-only: GET only"})
    return Handler


def load():
    cred = os.environ.get("CREDENTIALS_DIRECTORY")
    if not cred:
        sys.exit("farm-explorer: CREDENTIALS_DIRECTORY is not set (start it from farm-explorer.service)")
    # the unit hands over the config as a credential too, so this works whatever /etc/farm's mode is
    conf = os.path.join(cred, "conf") if os.path.exists(os.path.join(cred, "conf")) else CONF
    with open(conf, encoding="utf-8") as f:
        cfg = json.load(f)
    with open(os.path.join(cred, "key"), encoding="utf-8") as f:
        key = f.read().strip()
    if not key:
        sys.exit("farm-explorer: the key file is empty")
    return cfg, key


def main():
    cfg, key = load()
    ex = Explorer(cfg, key)
    host, port = cfg.get("listen", ["127.0.0.1", 29484])
    if host not in ("127.0.0.1", "::1", "localhost"):
        sys.exit("farm-explorer: listen must be loopback")
    srv = ThreadingHTTPServer((host, int(port)), make_handler(ex))
    srv.daemon_threads = True
    log(event="start", listen=f"{host}:{port}", chains=sorted(ex.chains))
    srv.serve_forever()


if __name__ == "__main__":
    main()
