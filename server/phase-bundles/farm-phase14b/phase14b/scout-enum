#!/usr/bin/env python3
"""scout-enum: fill /srv/farm/ws/scout/queue with candidates for the scout instances (phase 14b).

Runs as the earner user from farm-scout-enum.timer. No RPC calls of its own.
Sources (each candidate becomes one JSON file; a scout session measures exactly one):
  trial     non-ethereum leads closed as blocked_infra (decision 2026-11-17-cheap-chain-trials)
  actor     repeated actors from `ledger top` (7 days) that have no KB actors row
  protocol  DefiLlama protocols on the farm chains, TVL >= MIN_TVL, with no KB protocols row
Queue file name: <tier>-<age>-<id>.json, so a plain sort gives the order to work in.
Also returns stale files from doing/ to the queue (or to done/ after 2 retries).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

WS = os.environ.get("SCOUT_WS", "/srv/farm/ws")
KB = os.environ.get("KB_BIN", "/opt/farm/bin/kb")
LEDGER = os.environ.get("LEDGER_BIN", "/opt/farm/bin/ledger")
LLAMA_FILE = os.environ.get("LLAMA_FILE")          # tests: a saved /protocols response
Q, DOING, DONE = (f"{WS}/scout/{d}" for d in ("queue", "doing", "done"))
MIN_TVL = 100_000
MAX_QUEUE = 600
MAX_NEW_PER_RUN = 250
STALE_SEC = 45 * 60
CHEAP = ["base", "arbitrum", "optimism", "polygon", "bsc", "avalanche", "hyperevm"]
LLAMA_CHAINS = {"Ethereum": "ethereum", "Base": "base", "Arbitrum": "arbitrum", "BSC": "bsc",
                "Binance": "bsc", "Polygon": "polygon", "Avalanche": "avalanche",
                "OP Mainnet": "optimism", "Optimism": "optimism",
                "Hyperliquid L1": "hyperevm", "HyperEVM": "hyperevm"}
SKIP_CATEGORIES = {"CEX", "Chain", "Canonical Bridge"}
ADDR = re.compile(r"0x[0-9a-fA-F]{40}")


def norm(s):
    return re.sub(r"[^a-z0-9]+", "_", s.lower()).strip("_")


def cid(*parts):
    return re.sub(r"[^a-z0-9-]+", "-", "-".join(parts).lower()).strip("-")[:120]


def run(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if r.returncode:
        raise RuntimeError(f"{' '.join(cmd[:3])}: {r.stderr.strip()[:200]}")
    return r.stdout


def kb_all(table, cols, where="1=1"):
    """Page through a KB table 50 rows at a time (kb query caps at 50)."""
    rows, after = [], 0
    while True:
        out = run([KB, "query", "--json",
                   f"SELECT id, {cols} FROM {table} WHERE id > {after} AND ({where}) ORDER BY id LIMIT 50"])
        page = [json.loads(l) for l in out.splitlines() if l.strip().startswith("{")]
        rows += page
        if len(page) < 50:
            return rows
        after = page[-1]["id"]


def known_ids():
    ids = set()
    for d in (Q, DOING, DONE):
        for f in os.listdir(d):
            if f.endswith(".json"):
                ids.add(re.sub(r"^\d-\d{5}-", "", f[:-5]))
    return ids


def write(tier, age, item):
    path = f"{Q}/{tier}-{min(age, 99999):05d}-{item['id']}.json"
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(item, f, indent=1)
    os.rename(tmp, path)


def requeue_stale():
    n = 0
    now = time.time()
    for f in os.listdir(DOING):
        p = f"{DOING}/{f}"
        if not f.endswith(".json") or now - os.path.getmtime(p) < STALE_SEC:
            continue
        try:
            item = json.load(open(p, encoding="utf-8"))
        except ValueError:
            os.rename(p, f"{DONE}/{f}")
            continue
        item["retries"] = item.get("retries", 0) + 1
        item.pop("run_id", None)
        if item["retries"] > 2:
            item["result"] = {"verdict": "aborted", "line": "3 sessions ended without a result", "at": int(now)}
            json.dump(item, open(f"{DONE}/{f}", "w", encoding="utf-8"), indent=1)
            os.remove(p)
        else:
            write(item.get("tier", 5), item.get("age", 0), item)
            os.remove(p)
        n += 1
    return n


def trials(seen):
    out = []
    for r in kb_all("leads", "chain, target", "status='blocked_infra' AND chain NOT IN ('ethereum','any')"):
        i = cid("trial", r["chain"], f"lead{r['id']}")
        if i not in seen:
            out.append((1, 0, {"id": i, "kind": "trial", "tier": 1, "age": 0, "chain": r["chain"],
                               "lead_id": r["id"], "target": r["target"][:200]}))
    return out


def actors(seen):
    have = {(r["chain"], r["address"].lower()) for r in kb_all("actors", "chain, address")}
    out = []
    for chain in CHEAP + ["ethereum"]:
        try:
            text = run([LEDGER, "top", "--chain", chain, "--days", "7"])
        except Exception as e:
            print(f"  ledger top {chain}: {e}", file=sys.stderr)
            continue
        for a in list(dict.fromkeys(ADDR.findall(text)))[:15]:
            if (chain, a.lower()) in have:
                continue
            i = cid("actor", chain, a.lower())
            if i not in seen:
                out.append((2, 0, {"id": i, "kind": "actor", "tier": 2, "age": 0, "chain": chain,
                                   "address": a}))
    return out


def protocols(seen):
    if LLAMA_FILE:
        data = json.load(open(LLAMA_FILE, encoding="utf-8"))
    else:
        req = urllib.request.Request("https://api.llama.fi/protocols", headers={"User-Agent": "farm-scout-enum"})
        data = json.load(urllib.request.urlopen(req, timeout=90))
    have = {(r["chain"], norm(r["protocol"])) for r in kb_all("protocols", "chain, protocol")}
    now = time.time()
    out = []
    for p in data:
        if p.get("category") in SKIP_CATEGORIES or not p.get("slug"):
            continue
        names = {norm(p["slug"]), norm(p.get("name", ""))}
        for lc, tvl in (p.get("chainTvls") or {}).items():
            chain = LLAMA_CHAINS.get(lc)
            if not chain or not isinstance(tvl, (int, float)) or tvl < MIN_TVL:
                continue
            if any((chain, n) in have or ("any", n) in have for n in names):
                continue
            i = cid("protocol", chain, p["slug"])
            if i in seen:
                continue
            age = int((now - (p.get("listedAt") or 0)) / 86400) if p.get("listedAt") else 99999
            tier = 3 if chain in CHEAP else 4
            out.append((tier, age, {"id": i, "kind": "protocol", "tier": tier, "age": age, "chain": chain,
                                    "slug": p["slug"], "name": p.get("name"), "category": p.get("category"),
                                    "tvl_usd": round(tvl), "url": p.get("url"), "github": p.get("github"),
                                    "listed_days_ago": None if age == 99999 else age}))
    return out


def main():
    for d in (Q, DOING, DONE):
        os.makedirs(d, exist_ok=True)
    back = requeue_stale()
    seen = known_ids()
    queued = len([f for f in os.listdir(Q) if f.endswith(".json")])
    room = max(0, min(MAX_NEW_PER_RUN, MAX_QUEUE - queued))
    found = []
    for name, fn in (("trial", trials), ("actor", actors), ("protocol", protocols)):
        try:
            got = fn(seen)
        except Exception as e:
            print(f"  {name}: failed: {e}", file=sys.stderr)
            got = []
        print(f"  {name}: {len(got)} new candidates")
        found += got
    found.sort(key=lambda t: (t[0], t[1]))
    for tier, age, item in found[:room]:
        write(tier, age, item)
        seen.add(item["id"])
    print(f"scout-enum: requeued {back}, added {min(room, len(found))} of {len(found)}, "
          f"queue now {len([f for f in os.listdir(Q) if f.endswith('.json')])}")


if __name__ == "__main__":
    main()
