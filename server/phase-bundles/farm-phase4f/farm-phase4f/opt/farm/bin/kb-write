#!/usr/bin/env python3
"""Validated writer for the knowledge base.

Runs as farmdata via sudo (see /etc/sudoers.d/farm-data); agents can read the
database but only this program can write it. Every field is checked, attempts
are append-only, and every change is kept in the revisions table.

  kb-write --init
  kb-write --role R --model M --run-id ID add <table>        (JSON row on stdin)
  kb-write --role R --model M --run-id ID update <table> <id> (JSON fields on stdin)
"""
import argparse
import datetime as dt
import getpass
import json
import math
import os
import re
import sqlite3
import sys

DB_PATH = "/srv/farm/ws/kb/knowledge.db"
CHAINS_FILE = "/etc/farm/chains"
MAX_TEXT = 4000
MAX_STDIN = 64 * 1024

STATUS = ("measured", "unmeasured", "dead_end", "blocked_infra")
OUTCOMES = ("paper_placed", "fix_submitted", "lead_recorded",
            "dead_end_recorded", "blocked_infra", "aborted",
            # paper-reviewer decisions
            "review_promote", "review_fix", "review_wait", "review_demote",
            # live-operator / gate
            "stopped", "swept", "restarted")

_META = """
  author     TEXT NOT NULL,
  os_user    TEXT NOT NULL,
  run_id     TEXT NOT NULL,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL"""

SCHEMA = f"""
CREATE TABLE IF NOT EXISTS protocols (
  id         INTEGER PRIMARY KEY,
  chain      TEXT NOT NULL,
  protocol   TEXT NOT NULL,
  status     TEXT NOT NULL,
  checked    TEXT NOT NULL,      -- what was checked, with sources
  wiki_page  TEXT,{_META},
  UNIQUE (chain, protocol)
);
CREATE TABLE IF NOT EXISTS actors (
  id                 INTEGER PRIMARY KEY,
  chain              TEXT NOT NULL,
  address            TEXT NOT NULL,
  strategy           TEXT NOT NULL,
  est_profit_usd_day REAL,
  evidence           TEXT NOT NULL,  -- tx hashes, block ranges or ledger queries
  our_bot_id         TEXT,
  wiki_page          TEXT,{_META},
  UNIQUE (chain, address)
);
CREATE TABLE IF NOT EXISTS leads (
  id         INTEGER PRIMARY KEY,
  chain      TEXT NOT NULL,
  target     TEXT NOT NULL,
  why        TEXT NOT NULL,
  next_steps TEXT NOT NULL,
  status     TEXT NOT NULL DEFAULT 'unmeasured',
  wiki_page  TEXT,{_META},
  UNIQUE (chain, target)
);
CREATE TABLE IF NOT EXISTS attempts (
  id      INTEGER PRIMARY KEY,
  chain   TEXT NOT NULL,
  target  TEXT NOT NULL,
  outcome TEXT NOT NULL,
  reason  TEXT NOT NULL,
  numbers TEXT,                  -- figures with their sources
  bot_id  TEXT,{_META}
);
CREATE TABLE IF NOT EXISTS revisions (
  id      INTEGER PRIMARY KEY,
  tbl     TEXT NOT NULL,
  row_id  INTEGER NOT NULL,
  op      TEXT NOT NULL,
  before  TEXT,
  after   TEXT NOT NULL,
  author  TEXT NOT NULL,
  os_user TEXT NOT NULL,
  run_id  TEXT NOT NULL,
  at      TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS leads_status ON leads (status, updated_at);
CREATE INDEX IF NOT EXISTS attempts_target ON attempts (chain, target);
"""

# column -> validator name
FIELDS = {
    "protocols": {"chain": "chain", "protocol": "name", "status": "status",
                  "checked": "text", "wiki_page": "page"},
    "actors": {"chain": "chain", "address": "address", "strategy": "text",
               "est_profit_usd_day": "number", "evidence": "text",
               "our_bot_id": "ident", "wiki_page": "page"},
    "leads": {"chain": "chain", "target": "text", "why": "text",
              "next_steps": "text", "status": "status", "wiki_page": "page"},
    "attempts": {"chain": "chain", "target": "text", "outcome": "outcome",
                 "reason": "text", "numbers": "text", "bot_id": "ident"},
}
REQUIRED = {
    "protocols": ("chain", "protocol", "status", "checked"),
    "actors": ("chain", "address", "strategy", "evidence"),
    "leads": ("chain", "target", "why", "next_steps"),
    "attempts": ("chain", "target", "outcome", "reason"),
}
KEYS = {  # identity of a row: can't be changed by update
    "protocols": ("chain", "protocol"),
    "actors": ("chain", "address"),
    "leads": ("chain", "target"),
}
APPEND_ONLY = {"attempts"}

IDENT_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
PAGE_RE = re.compile(r"^(?:[a-z0-9][a-z0-9_-]*/){0,3}[a-z0-9][a-z0-9_-]*\.md$")
ADDRESS_RE = re.compile(r"^0x[0-9a-f]{40}$")
WHO_RE = re.compile(r"^[A-Za-z0-9._/-]{1,64}$")


class Invalid(Exception):
    pass


def allowed_chains():
    try:
        with open(CHAINS_FILE, encoding="utf-8") as f:
            chains = {line.strip() for line in f if line.strip() and not line.startswith("#")}
    except OSError:
        chains = set()
    return chains | {"any"}


def clean(kind, field, value):
    if value is None:
        return None
    if kind == "number":
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
            raise Invalid(f"{field}: must be a number")
        return float(value)
    if not isinstance(value, str):
        raise Invalid(f"{field}: must be a string")
    value = value.strip()
    if not value or "\x00" in value:
        raise Invalid(f"{field}: must not be empty")
    if kind == "text":
        if len(value) > MAX_TEXT:
            raise Invalid(f"{field}: longer than {MAX_TEXT} characters; put details in a wiki page")
        return value
    if kind == "chain":
        value = value.lower()
        chains = allowed_chains()
        if value not in chains:
            raise Invalid(f"{field}: must be one of {sorted(chains)}")
        return value
    if kind == "name":
        value = re.sub(r"\s+", "-", value.lower())
        if not IDENT_RE.match(value):
            raise Invalid(f"{field}: use lowercase letters, digits, '.', '_' or '-' (max 64)")
        return value
    if kind == "ident":
        if not IDENT_RE.match(value):
            raise Invalid(f"{field}: use lowercase letters, digits, '.', '_' or '-' (max 64)")
        return value
    if kind == "address":
        value = value.lower()
        if not ADDRESS_RE.match(value):
            raise Invalid(f"{field}: must be a 0x-prefixed 20-byte hex address")
        return value
    if kind == "page":
        if not PAGE_RE.match(value):
            raise Invalid(f"{field}: must be a wiki path like 'mechanism/aave-liquidation.md'")
        return value
    if kind == "status":
        if value not in STATUS:
            raise Invalid(f"{field}: must be one of {list(STATUS)}")
        return value
    if kind == "outcome":
        if value not in OUTCOMES:
            raise Invalid(f"{field}: must be one of {list(OUTCOMES)}")
        return value
    raise Invalid(f"{field}: unknown kind {kind}")


def validate(table, data, *, partial):
    if table not in FIELDS:
        raise Invalid(f"unknown table '{table}'; use one of {sorted(FIELDS)}")
    if not isinstance(data, dict) or not data:
        raise Invalid("expected a JSON object with at least one field")
    spec = FIELDS[table]
    unknown = sorted(set(data) - set(spec))
    if unknown:
        raise Invalid(f"unknown fields {unknown}; {table} has {sorted(spec)}")
    if not partial:
        missing = [f for f in REQUIRED[table] if data.get(f) in (None, "")]
        if missing:
            raise Invalid(f"missing required fields {missing}")
    return {field: clean(spec[field], field, value) for field, value in data.items()}


def now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def connect():
    con = sqlite3.connect(DB_PATH, timeout=15)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA busy_timeout=15000")
    return con


def init():
    con = connect()
    con.executescript(SCHEMA)
    con.close()
    os.chmod(DB_PATH, 0o644)
    print(f"ok initialized {DB_PATH}")


def add(con, table, row, who):
    cols = list(row) + ["author", "os_user", "run_id", "created_at", "updated_at"]
    ts = now()
    vals = list(row.values()) + [who["author"], who["os_user"], who["run_id"], ts, ts]
    try:
        with con:
            cur = con.execute(
                f"INSERT INTO {table} ({','.join(cols)}) VALUES ({','.join('?' * len(vals))})", vals)
            row_id = cur.lastrowid
            con.execute(
                "INSERT INTO revisions (tbl,row_id,op,before,after,author,os_user,run_id,at)"
                " VALUES (?,?,?,?,?,?,?,?,?)",
                (table, row_id, "add", None, json.dumps(row, ensure_ascii=False),
                 who["author"], who["os_user"], who["run_id"], ts))
    except sqlite3.IntegrityError:
        key = KEYS.get(table, ())
        existing = con.execute(
            f"SELECT id FROM {table} WHERE " + " AND ".join(f"{k}=?" for k in key),
            [row[k] for k in key]).fetchone() if key else None
        if existing:
            raise Invalid(f"already exists as {table} id={existing['id']}; "
                          f"use: kb update {table} {existing['id']} '<json>'") from None
        raise
    return row_id


def update(con, table, row_id, fields, who):
    if table in APPEND_ONLY:
        raise Invalid(f"{table} is append-only; add a new row instead")
    frozen = sorted(set(fields) & set(KEYS.get(table, ())))
    if frozen:
        raise Invalid(f"{frozen} identify the row and can't be changed; add a new row instead")
    before = con.execute(f"SELECT * FROM {table} WHERE id=?", (row_id,)).fetchone()
    if before is None:
        raise Invalid(f"{table} id={row_id} not found")
    ts = now()
    sets = ", ".join(f"{k}=?" for k in fields) + ", author=?, os_user=?, run_id=?, updated_at=?"
    with con:
        con.execute(f"UPDATE {table} SET {sets} WHERE id=?",
                    list(fields.values()) + [who["author"], who["os_user"], who["run_id"], ts, row_id])
        con.execute(
            "INSERT INTO revisions (tbl,row_id,op,before,after,author,os_user,run_id,at)"
            " VALUES (?,?,?,?,?,?,?,?,?)",
            (table, row_id, "update",
             json.dumps({k: before[k] for k in fields}, ensure_ascii=False),
             json.dumps(fields, ensure_ascii=False),
             who["author"], who["os_user"], who["run_id"], ts))


def main(argv=None, stdin=None):
    p = argparse.ArgumentParser(prog="kb-write")
    p.add_argument("--init", action="store_true")
    p.add_argument("--role", default="unknown")
    p.add_argument("--model", default="unknown")
    p.add_argument("--run-id", default="manual")
    p.add_argument("op", nargs="?", choices=("add", "update"))
    p.add_argument("table", nargs="?")
    p.add_argument("row_id", nargs="?", type=int)
    args = p.parse_args(argv)

    if args.init:
        init()
        return 0
    try:
        if not args.op or not args.table:
            raise Invalid("usage: kb-write ... add <table> | update <table> <id>")
        for label, value in (("role", args.role), ("model", args.model), ("run-id", args.run_id)):
            if not WHO_RE.match(value):
                raise Invalid(f"--{label}: invalid value")
        raw = (stdin or sys.stdin).read(MAX_STDIN + 1)
        if len(raw) > MAX_STDIN:
            raise Invalid("input too large")
        try:
            data = json.loads(raw)
        except ValueError as exc:
            raise Invalid(f"input is not valid JSON: {exc}") from None
        who = {
            "author": f"{args.role}/{args.model}",
            "os_user": os.environ.get("SUDO_USER") or getpass.getuser(),
            "run_id": args.run_id,
        }
        con = connect()
        try:
            if args.op == "add":
                row = validate(args.table, data, partial=False)
                row_id = add(con, args.table, row, who)
                print(f"ok added {args.table} id={row_id}")
            else:
                if args.row_id is None:
                    raise Invalid("usage: kb update <table> <id> '<json>'")
                fields = validate(args.table, data, partial=True)
                update(con, args.table, args.row_id, fields, who)
                print(f"ok updated {args.table} id={args.row_id}")
        finally:
            con.close()
    except Invalid as exc:
        print(f"kb: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
