#!/usr/bin/env bash
# Run one agent session for an instance. Started by agent@<instance>.service.
# The fixed prompt was assembled by assemble-prompt (as root) just before this.
set -euo pipefail

INSTANCE="${1:?usage: run-role <instance>}"
: "${FARM_WS:?FARM_WS not set}" "${CLAUDE_BIN:?}" "${CODEX_BIN:?}" "${DSH_CMD:?}"

ROLE="" HARNESS="" MODEL=""
read -r ROLE HARNESS MODEL < <(awk -v i="$INSTANCE" '$1 == i { print $2, $3, $4 }' /etc/farm/roles.conf) || true
if [[ -z "$ROLE" ]]; then
  echo "run-role: unknown instance: $INSTANCE" >&2
  exit 2
fi

# Services don't get a login shell's PATH, and each user has its own node.
# /opt/farm/bin comes first so 'kb' and 'wiki' resolve to the farm tools.
if [[ "$HARNESS" == dsh ]]; then
  export PATH="/opt/farm/bin:${EARNER_PATH:?EARNER_PATH not set}"
else
  export PATH="/opt/farm/bin:${HARNESS_PATH:?HARNESS_PATH not set}"
fi

# Read by kb / wiki to label writes. run_id is the systemd invocation id,
# the same value record-run stores as runs.run_id.
export FARM_ROLE="$ROLE" FARM_MODEL="$MODEL" FARM_RUN_ID="${INVOCATION_ID:-manual}"

RUNNER_DIR="/srv/farm/runners/$INSTANCE"
PROMPT_FILE="$RUNNER_DIR/prompt.md"

# Everything that changes per run goes last, so the fixed prefix stays cacheable.
context() {
  echo "## Session context"
  echo
  echo "- UTC time now: $(date -u +%Y-%m-%dT%H:%M:%SZ) (session started now; it is killed after ${SESSION_MAX_MIN:-75} minutes, at $(date -u -d "+${SESSION_MAX_MIN:-75} minutes" +%H:%MZ))"
  echo "- run_id: $FARM_RUN_ID"
  echo "- role: $ROLE (instance: $INSTANCE)"
  echo "- model: $MODEL"
  if [[ -x "/opt/farm/context/$ROLE" ]]; then
    "/opt/farm/context/$ROLE" "$INSTANCE" || echo "- (context generator failed)"
  fi
  if [[ -f /etc/farm/smoke ]]; then
    echo
    cat /etc/farm/smoke
  else
    echo
    echo "Start your session now, following your role instructions."
  fi
}

# Claude Code permission rules. A leading '//' marks an absolute path.
# Anything not listed here is denied (--permission-mode dontAsk).
claude_tools() {
  local ws="//srv/farm/ws"      # Edit() rules: a leading // marks an absolute path
  local wsb="/srv/farm/ws"      # Bash() rules match the command line literally
  local common="Read,Grep,Glob,Bash(python3 $wsb/tools/session-report.py *),Bash(kb *),Bash(wiki *),Bash(ledger *),Bash(websearch *),Bash(curl *),Bash(gate status*),Bash(fork *),Bash(/opt/foundry/bin/forge *),Bash(/opt/foundry/bin/cast *),Bash(paper list),Bash(paper status *),Bash(paper logs *),Edit($ws/scratch/**)"
  case "$ROLE" in
    meta)
      # workspace tools (tools/ is meta/researcher-owned) and read-only git history of the workspace
      echo "$common,Bash(date*),Edit($ws/**),Edit(//srv/farm/prompts/roles/**),Bash(python3 $wsb/tools/*),Bash(git -C $wsb/history log*),Bash(git -C $wsb/history show*),Bash(git -C $wsb/history diff*),Bash(git -C $wsb/wiki log*),Bash(git -C $wsb/wiki show*),Bash(git -C $wsb/wiki diff*)" ;;
    live-operator)
      echo "$common,Bash(gate *),Bash(paper *),Edit($ws/inbox/**),Edit($ws/logs/**),Edit($ws/bots/paper/**)" ;;
    paper-reviewer)
      # review.md, session report, inbox notes; promote and archive are the only gate/paper writes it needs
      echo "$common,Bash(gate promote *),Bash(gate accounts),Bash(gate intermediate),Bash(paper archive *),Edit($ws/inbox/**),Edit($ws/logs/**),Edit($ws/bots/paper/**)" ;;
    *)
      echo "$common" ;;
  esac
}

CONTEXT="$(context)"

case "$HARNESS" in
  claude)
    # Start from a root-owned, empty directory so no project settings, hooks
    # or CLAUDE.md written by another agent get loaded.
    cd "$RUNNER_DIR"
    exec "$CLAUDE_BIN" -p "$CONTEXT" \
      --model "$MODEL" \
      --append-system-prompt-file "$PROMPT_FILE" \
      --settings /etc/farm/claude-settings.json \
      --add-dir "$FARM_WS" \
      --permission-mode dontAsk \
      --allowedTools "$(claude_tools)" \
      --output-format stream-json --verbose
    ;;
  codex)
    # Codex's own sandbox blocks network and sudo, which these roles need.
    # The boundary is the OS user (harness), not the codex sandbox.
    cd "$FARM_WS"
    exec "$CODEX_BIN" exec --skip-git-repo-check --sandbox danger-full-access \
      -m "$MODEL" "$(cat "$PROMPT_FILE")

$CONTEXT"
    ;;
  dsh)
    # Instructions reach dsh through ~/.dsh/AGENTS.md, a read-only bind mount
    # of the assembled prompt (see the agent@earner-local drop-in).
    # The local model sometimes ends its turn inside its reasoning, with no tool call and no
    # answer; dsh then exits 0 as if the task were done. When that happens with session time
    # left and no session report written, start dsh again (up to 2 more times) in the same run.
    cd "$FARM_WS"
    read -ra dsh_cmd <<< "$DSH_CMD"
    t0=$(date -u +%s)
    budget=$(( ${SESSION_MAX_MIN:-75} * 60 ))
    attempt=0
    while :; do
      attempt=$((attempt + 1))
      extra=""
      if (( attempt > 1 )); then
        extra="

### Resumed
This is attempt $attempt of this same session (run_id unchanged). Your previous attempt ended without a tool call and without a session report, so nothing after your last recorded step happened. Re-read your claim, scratch/ and the KB rows for this run_id, continue from there, and finish with the session report. Act with tool calls; a turn that ends in reasoning alone ends the session."
      fi
      if "${dsh_cmd[@]}" "$CONTEXT$extra"; then rc=0; else rc=$?; fi   # set -e safe
      left=$(( budget - ($(date -u +%s) - t0) ))
      if grep -qs "$FARM_RUN_ID" "$FARM_WS/logs/sessions/$(date -u +%F).jsonl" "$FARM_WS/logs/sessions/$(date -u -d yesterday +%F).jsonl"; then
        exit $rc                                  # reported: done, whatever the exit code
      fi
      if (( rc != 0 )) || (( attempt >= 3 )) || (( left < 600 )); then
        echo "run-role: dsh ended (rc=$rc) without a session report; attempt $attempt, ${left}s left; giving up" >&2
        exit $rc
      fi
      echo "run-role: dsh ended rc=0 without a tool call or report (attempt $attempt, ${left}s left); resuming in 15s" >&2
      sleep 15
    done
    ;;
  *)
    echo "run-role: unknown harness: $HARNESS" >&2
    exit 2
    ;;
esac
