# Read by agent@.service. Use absolute paths: services don't get a login shell's
# PATH, and harness's node comes from nvm, which only .bashrc loads.
# If harness switches node versions with nvm, update HARNESS_PATH and CODEX_BIN.
HARNESS_PATH=/home/harness/.nvm/versions/node/v24.22.1/bin:/home/harness/.local/bin:/usr/local/bin:/usr/bin:/bin
EARNER_PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin

CLAUDE_BIN=/home/harness/.local/bin/claude
CODEX_BIN=/home/harness/.nvm/versions/node/v24.22.1/bin/codex

# dsh for the earner, installed root-owned under /opt/farm/dsh so the earner
# can't modify the harness that runs it.
DSH_CMD="/opt/farm/dsh/node_modules/.bin/dsh --profile headless"

FARM_WS=/srv/farm/ws
