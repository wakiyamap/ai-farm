#!/usr/bin/env python3
"""farm-hermes: a local door to Pyth Hermes that adds the human's Pyth API key (phase 15c).

Agents and bots call http://127.0.0.1:29486/<path> exactly as they would call
https://pyth.dourolabs.app/hermes/<path> (or hermes.pyth.network/<path>); this service adds the
`Authorization: Bearer <key>` header and passes the answer back. Nobody else sees the key.
Read-only price endpoints only (latest / timestamped price updates, price feed list, TWAP, the
v1 /api routes); the streaming endpoint is refused (it never ends). Everything else is refused.

Config: the `conf` credential (/etc/farm/hermes.json, no secrets). Key: the `key` credential
(/etc/farm/pyth-hermes.key, root 0600). Standard library only. Based on farm-relayapi (12f).

  GET /health     counters (this service's own)
"""
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = os.environ.get("FARM_HERMES_CONF", "/etc/farm/hermes.json")
PATH_RE = re.compile(r"^/[A-Za-z0-9_\-./]{1,200}$")
MAX_ANSWER = 16 * 1024 * 1024


class Refused(Exception):
    """(status, message)"""


class HermesApi:
    def __init__(self, cfg, key):
        self.cfg, self.key = cfg, key
        self.lock = threading.Lock()
        self.last_call = 0.0
        self.day, self.calls_today = "", 0
        self.stats = {"upstream_ok": 0, "upstream_error": 0, "refused": 0}

    def scrub(self, data):
        """The key never leaves this process, whatever the upstream echoes back."""
        k = self.key.encode() if isinstance(data, bytes) else self.key
        return data.replace(k, b"***" if isinstance(data, bytes) else "***") if self.key else data

    def auth_headers(self):
        return {"Authorization": "Bearer " + self.key}

    def allowed(self, method, path):
        if not PATH_RE.match(path) or ".." in path or "//" in path:
            return False
        for d in self.cfg.get("deny", []):
            if path == d or path.startswith(d + "/"):
                return False
        for prefix in self.cfg.get("allow", {}).get(method, []):
            if path == prefix or path.startswith(prefix + "/"):
                return True
        return False

    def forward(self, method, path, query):
        if not self.allowed(method, path):
            raise Refused((403, f"{method} {path} is not passed on. Allowed: "
                                + "; ".join(f"{m} {', '.join(p)}" for m, p in sorted(self.cfg.get("allow", {}).items()))
                                + (f"; refused: {', '.join(self.cfg.get('deny', []))}" if self.cfg.get("deny") else "")))
        with self.lock:
            today = time.strftime("%Y-%m-%d", time.gmtime())
            if today != self.day:
                self.day, self.calls_today = today, 0
            limit = self.cfg.get("daily_limit", 30000)
            if self.calls_today >= limit:
                raise Refused((429, f"daily limit of {limit} Hermes calls reached; it resets at 00:00 UTC"))
            wait = self.cfg.get("min_interval_s", 0.05) - (time.monotonic() - self.last_call)
            if wait > 0:
                time.sleep(wait)
            self.last_call = time.monotonic()
            self.calls_today += 1
        url = self.cfg["upstream"].rstrip("/") + path + ("?" + query if query else "")
        headers = {**self.auth_headers(), "Accept": "application/json", "User-Agent": "farm-hermes/1"}
        req = urllib.request.Request(url, headers=headers, method=method)
        t0 = time.monotonic()
        try:
            with urllib.request.urlopen(req, timeout=self.cfg.get("timeout_s", 10)) as r:
                status, data = r.status, r.read(MAX_ANSWER)
        except urllib.error.HTTPError as exc:                 # Hermes' own 4xx / 5xx: pass it back as it is
            status, data = exc.code, exc.read(MAX_ANSWER)
        except Exception as exc:                              # noqa: BLE001 - network, timeout
            self.stats["upstream_error"] += 1
            log(method=method, path=path, ok=False, ms=int((time.monotonic() - t0) * 1000),
                why=self.scrub(repr(exc))[:200])
            raise Refused((502, "Hermes unreachable: " + self.scrub(str(exc) or type(exc).__name__)[:300]))
        self.stats["upstream_ok" if status < 400 else "upstream_error"] += 1
        log(method=method, path=path, status=status, ms=int((time.monotonic() - t0) * 1000))
        return status, self.scrub(data)


def log(**kw):
    print(json.dumps(dict(ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **kw)), flush=True)


def make_handler(api):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def send(self, status, body, ctype="application/json"):
            if not isinstance(body, bytes):
                body = json.dumps(body).encode()
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):                                     # noqa: N802
            path, _, query = self.path.partition("?")
            try:
                if path == "/health":
                    return self.send(200, {"ok": True, "day": api.day, "calls_today": api.calls_today,
                                           "daily_limit": api.cfg.get("daily_limit", 30000), **api.stats})
                status, data = api.forward("GET", path, query)
                return self.send(status, data)
            except Refused as exc:
                api.stats["refused"] += 1
                status, why = exc.args[0]
                return self.send(status, {"error": why, "from": "farm-hermes"})
            except Exception as exc:                          # noqa: BLE001 - never a traceback with the key in it
                return self.send(500, {"error": "farm-hermes internal error: " + api.scrub(repr(exc))[:200]})

        def do_POST(self):                                    # noqa: N802
            self.send(405, {"error": "GET only", "from": "farm-hermes"})
        do_PUT = do_DELETE = do_PATCH = do_POST
    return Handler


def load():
    cred = os.environ.get("CREDENTIALS_DIRECTORY")
    if not cred:
        sys.exit("farm-hermes: CREDENTIALS_DIRECTORY is not set (start it from farm-hermes.service)")
    conf = os.path.join(cred, "conf") if os.path.exists(os.path.join(cred, "conf")) else CONF
    with open(conf, encoding="utf-8") as f:
        cfg = json.load(f)
    with open(os.path.join(cred, "key"), encoding="utf-8") as f:
        key = f.read().strip()
    if not key:
        sys.exit("farm-hermes: the key file is empty")
    return cfg, key


def main():
    cfg, key = load()
    host, port = cfg.get("listen", ["127.0.0.1", 29486])
    if host not in ("127.0.0.1", "::1", "localhost"):
        sys.exit("farm-hermes: listen must be loopback")
    if not cfg["upstream"].startswith("https://"):
        sys.exit("farm-hermes: upstream must be https")
    srv = ThreadingHTTPServer((host, int(port)), make_handler(HermesApi(cfg, key)))
    srv.daemon_threads = True
    log(event="start", listen=f"{host}:{port}", upstream=cfg["upstream"])
    srv.serve_forever()


if __name__ == "__main__":
    main()
