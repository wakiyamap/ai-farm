#!/usr/bin/env python3
"""Privileged half of the paper runner. Runs as root via sudo; every argument
is validated here, so sudoers only ever grants this one program.

  paper-ctl start <id>                 start paper@<id>.service
  paper-ctl stop <id>
  paper-ctl restart <id>
  paper-ctl archive <id> <reason>      stop, move bots/paper/<id> to bots/archive/<id>, write ARCHIVE.md

Logs and status need no privilege and live in the agent-facing `paper` CLI.
"""
import datetime as dt
import os
import re
import shutil
import subprocess
import sys

WS = "/srv/farm/ws"
PAPER = f"{WS}/bots/paper"
ARCHIVE = f"{WS}/bots/archive"
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,47}$")
MAX_RUNNING = 12


def die(msg, code=2):
    print(f"paper-ctl: {msg}", file=sys.stderr)
    sys.exit(code)


def check_id(bot_id):
    if not ID_RE.match(bot_id):
        die("bot id must be 3-48 chars of lowercase letters, digits and '-'")
    return bot_id


def systemctl(*args):
    return subprocess.run(["systemctl", *args], capture_output=True, text=True, check=False)


def running_count():
    out = systemctl("list-units", "--plain", "--no-legend", "--state=active", "paper@*.service").stdout
    return len([l for l in out.splitlines() if l.strip()])


def preflight(bot_id):
    d = os.path.join(PAPER, bot_id)
    if not os.path.isdir(d):
        die(f"no such paper bot: {bot_id}")
    run = os.path.join(d, "run.sh")
    if not os.path.isfile(run) or not os.access(run, os.X_OK):
        die(f"{bot_id}: run.sh missing or not executable")
    if not os.path.isfile(os.path.join(d, "manifest.yaml")):
        die(f"{bot_id}: manifest.yaml missing")
    if os.path.islink(d) or os.path.islink(run):
        die(f"{bot_id}: symlinks are not allowed")


def start(bot_id):
    preflight(bot_id)
    if running_count() >= MAX_RUNNING:
        die(f"{MAX_RUNNING} paper bots already running; archive one first")
    d = os.path.join(PAPER, bot_id)
    os.makedirs(os.path.join(d, "logs"), exist_ok=True)
    # farmbot must be able to read the code and write logs/state
    subprocess.run(["chgrp", "-R", "farm", d], check=False)
    subprocess.run(["chmod", "-R", "g+rX", d], check=False)
    subprocess.run(["chmod", "g+w", os.path.join(d, "logs")], check=False)
    for sub in ("state",):
        p = os.path.join(d, sub)
        os.makedirs(p, exist_ok=True)
        subprocess.run(["chown", "farmbot:farm", p], check=False)
    subprocess.run(["chown", "farmbot:farm", os.path.join(d, "logs")], check=False)
    r = systemctl("start", f"paper@{bot_id}.service")
    if r.returncode:
        die(f"start failed: {r.stderr.strip()}")
    print(f"ok started paper@{bot_id}")


def stop(bot_id):
    r = systemctl("stop", f"paper@{bot_id}.service")
    if r.returncode:
        die(f"stop failed: {r.stderr.strip()}")
    print(f"ok stopped paper@{bot_id}")


def restart(bot_id):
    preflight(bot_id)
    r = systemctl("restart", f"paper@{bot_id}.service")
    if r.returncode:
        die(f"restart failed: {r.stderr.strip()}")
    print(f"ok restarted paper@{bot_id}")


def archive(bot_id, reason):
    if not reason.strip() or len(reason) > 500 or "\n" in reason:
        die("reason must be one line, 1-500 chars")
    src = os.path.join(PAPER, bot_id)
    if not os.path.isdir(src):
        die(f"no such paper bot: {bot_id}")
    systemctl("stop", f"paper@{bot_id}.service")
    systemctl("reset-failed", f"paper@{bot_id}.service")
    dest = os.path.join(ARCHIVE, bot_id)
    n = 1
    while os.path.exists(dest):
        n += 1
        dest = os.path.join(ARCHIVE, f"{bot_id}-{n}")
    who = os.environ.get("SUDO_USER", "?")
    with open(os.path.join(src, "ARCHIVE.md"), "a", encoding="utf-8") as f:
        f.write(f"# Archived\n\n- when: {dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')}\n"
                f"- by (os user): {who}\n- role/run: {os.environ.get('FARM_ROLE','?')}/{os.environ.get('FARM_RUN_ID','?')}\n"
                f"- reason: {reason}\n")
    shutil.move(src, dest)
    subprocess.run(["chown", "-R", "farmgate:farm", dest], check=False)
    subprocess.run(["chmod", "-R", "a-w,g+rX,o+rX", dest], check=False)
    print(f"ok archived {bot_id} -> {os.path.relpath(dest, WS)}")


def main(argv):
    if len(argv) >= 2 and argv[0] in ("start", "stop", "restart") and len(argv) == 2:
        bot_id = check_id(argv[1])
        {"start": start, "stop": stop, "restart": restart}[argv[0]](bot_id)
    elif len(argv) == 3 and argv[0] == "archive":
        archive(check_id(argv[1]), argv[2])
    else:
        die("usage: paper-ctl start|stop|restart <id> | archive <id> <reason>")


if __name__ == "__main__":
    if os.geteuid() != 0:
        die("must run as root (via sudo)")
    main(sys.argv[1:])
