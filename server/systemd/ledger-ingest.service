[Unit]
Description=Farm ledger ingest (selected events via the RPC relay)
After=rpc-relay.service
Requires=rpc-relay.service

[Service]
Type=oneshot
User=farmdata
Group=farm
UMask=0022
ExecStart=/usr/bin/python3 -I /opt/farm/bin/ledger-ingest
TimeoutStartSec=20min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/farm/ws/ledger
SyslogIdentifier=ledger-ingest
