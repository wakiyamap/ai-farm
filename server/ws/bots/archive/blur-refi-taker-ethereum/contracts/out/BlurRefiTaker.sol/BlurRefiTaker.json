it","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"sweep"},{"inputs":[{"internalType":"uint256","name":"lienId","type":"uint256"},{"internalType":"struct Lien","name":"lien","type":"tuple","components":[{"internalType":"address","name":"lender","type":"address"},{"internalType":"address","name":"borrower","type":"address"},{"internalType":"address","name":"collection","type":"address"},{"internalType":"uint256","name":"tokenId","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"uint256","name":"startTime","type":"uint256"},{"internalType":"uint256","name":"rate","type":"uint256"},{"internalType":"uint256","name":"auctionStartBlock","type":"uint256"},{"internalType":"uint256","name":"auctionDuration","type":"uint256"}]},{"internalType":"uint256","name":"rate","type":"uint256"},{"internalType":"uint256","name":"debtCap","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"take"},{"inputs":[],"stateMutability":"view","type":"function","name":"withdrawing","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[],"stateMutability":"payable","type":"receive"}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{"mint()":{"notice":"Fork-only repayment simulation: the real venue pays accrued debt as Pool units (Blend's transferFrom from the borrower) without touching the funded float; on the fork a repayment is any native this contract mints without counting it as funded. Never used by the bot live."},"sweep(uint256,uint256)":{"notice":"After a measured Repay/Refinance on our taken lien: debt plus accrued interest came back to this contract as Pool units, so the Pool balance is at least the funded float again; the excess is the realized interest profit, withdrawn from the pool as native and sent to the bot wallet in the same transaction."},"take(uint256,(address,address,address,uint256,uint256,uint256,uint256,uint256,uint256