270,"length":32},{"start":1866,"length":32}],"87":[{"start":231,"length":32},{"start":315,"length":32},{"start":953,"length":32},{"start":1381,"length":32},{"start":1554,"length":32},{"start":1734,"length":32},{"start":1819,"length":32},{"start":2015,"length":32},{"start":2100,"length":32}]}},"methodIdentifiers":{"bid(uint32,uint256,address)":"1101c2b2","hub()":"365a86fc","owner()":"8da5cb5b","sweep(address,uint256)":"6ea056a9","sweepZCHF(uint256)":"2ae6f78b","zchf()":"c4d4803a"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.26+commit.8a97fa7a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"hub_\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"zchf_\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"BadCollateralDelta\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"BadOwnerDelta\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"BadTransfer\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NoChallenge\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NoProfit\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NotOwner\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint32\",\"name\":\"num\",\"type\":\"uint32\"},{\"internalType\":\"uint256\",\"name\":\"size\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"bid\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"hub\",\"outputs\":[{\"internalType\":\"contract IHub\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"sweep\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"sweepZCHF\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"zchf\",\"outputs\":[{\"internalType\":\"contract IZCHF\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"bid(uint32,uint256,address)\":{\"params\":{\"num\":\"challenge number from the ChallengeStarted event\",\"size\":\"desired collateral size (capped to the remaining challenge size)\",\"token\":\"collateral token (the gained delta is paid out and verified against it)\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"sweep(address,uint256)\":{\"notice\":\"Owner recovery for any collateral left in the executor (the normal path pays out inside bid; kept for stranded balances, with the ERC-20 return value checked).\"},\"sweepZCHF(uint256)\":{\"notice\":\"Owner withdraws any ZCHF left in the executor in a separate transaction.\"}},\"notice\":\"One-transaction Dutch-challenge bidder for the frankencoin MintingHub. The bot bids only after the hub's Dutch price has fully decayed (the hub price is exactly 0 from start + 2 * phase on, measured from the verified hub source), so the bid pays zero ZCHF. The contract enforces the gain for every accepted input: it reverts unless the challenge still exists (NoChallenge), the hub offer (hub.price(num) * sz / 1e18) is exactly 0 (NoProfit), the received collateral delta equals the bid size sz >= 1 exactly (BadCollateralDelta), the payout transfer to the owner succeeds (BadTransfer) and the owner's token balance delta equals the gained size exactly (BadOwnerDelta). The whole action - the bid and the payout to the bot wallet - is therefore ONE transaction through this contract, and every accepted call ends with the owner holding strictly more collateral than before it and zero ZCHF paid, whatever maxOffer the caller claimed: the worst case is the transaction gas.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/DutchBidder.sol\":\"DutchBidder\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/DutchBidder.sol\":{\"keccak256\":\"0xae131330bed4ca800f1f37c47624bf468ea2890454f60eee3124b0f9f8bbb36b\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://5520eaa3b293c2b6cea1ff812068de383667e53a5c839905bb8047e328527870\",\"dweb:/ipfs/QmbeNKrrKwK3FaN4WAnEYJ3rPT5Ne8HjTkhCkk99is4jjJ\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.26+commit.8a97fa7a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"hub_","type":"address"},{"internalType":"address","name":"zchf_","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"BadCollateralDelta"},{"inputs":[],"type":"error","name":"BadOwnerDelta"},{"inputs":[],"type":"error","name":"BadTransfer"},{"inputs":[],"type":"error","name":"NoChallenge"},{"inputs":[],"type":"error","name":"NoProfit"},{"inputs":[],"type":"error","name":"NotOwner"},{"inputs":[{"internalType":"uint32","name":"num","type":"uint32"},{"internalType":"uint256","name":"size","type":"uint256"},{"internalType":"address","name":"token","type":"address"}],"stateMutability":"nonpayable","type":"function","name":"bid"},{"inputs":[],"stateMutability":"view","type":"function","name":"hub","outputs":[{"internalType":"contract IHub","name":"","type":"address"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}]},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"sweep"},{"inputs":[{"internalTyp