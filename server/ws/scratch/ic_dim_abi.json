# via etherscan
constructorNone(address,uint256)
calculateTotalFees(address,uint256,bool) view -> (uint256,uint256,uint256)
controller() view -> (address)
getModuleIssuanceHooks(address) view -> (address[])
getRequiredComponentIssuanceUnits(address,uint256) view -> (address[],uint256[],uint256[])
getRequiredComponentRedemptionUnits(address,uint256) view -> (address[],uint256[],uint256[])
initialize(address,uint256,uint256,uint256,address,address)
isModuleIssuanceHook(address,address) view -> (bool)
issuanceSettings(address) view -> (uint256,uint256,uint256,address,address)
issue(address,uint256,address)
redeem(address,uint256,address)
registerToIssuanceModule(address)
removeModule()
tokenTransferBuffer() view -> (uint256)
unregisterFromIssuanceModule(address)
updateFeeRecipient(address,address)
updateIssueFee(address,uint256)
updateRedeemFee(address,uint256)
event FeeRecipientUpdated(address,address)
event IssueFeeUpdated(address,uint256)
event RedeemFeeUpdated(address,uint256)
event SetTokenIssued(address,address,address,address,uint256,uint256,uint256)
event SetTokenRedeemed(address,address,address,uint256,uint256,uint256)
