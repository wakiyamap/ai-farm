# via etherscan
constructorNone(uint256)
ENABLE_WINDOW_DURATION_SLOT() view -> (bytes32)
MAX_UPGRADE_DELAY() view -> (uint256)
PROXY_VERSION() view -> (string)
UPGRADE_DELAY_SLOT() view -> (bytes32)
addImplementation(address,bytes,bool)
getEnableWindowDuration() view -> (uint256)
getUpgradeActivationDelay() view -> (uint256)
implementation() view -> (address)
initialize(bytes) pure
isAppGovernor(address) view -> (bool)
isAppRoleAdmin(address) view -> (bool)
isGovernanceAdmin(address) view -> (bool)
isNotFinalized() view -> (bool)
isUpgradeGovernor(address) view -> (bool)
registerAppGovernor(address)
registerAppRoleAdmin(address)
registerGovernanceAdmin(address)
registerUpgradeGovernor(address)
removeImplementation(address,bytes,bool)
renounceRole(bytes32,address)
revokeAppGovernor(address)
revokeAppRoleAdmin(address)
revokeGovernanceAdmin(address)
revokeUpgradeGovernor(address)
upgradeTo(address,bytes,bool) payable
event FinalizedImplementation(address)
event ImplementationAdded(address,bytes,bool)
event ImplementationRemoved(address,bytes,bool)
event ImplementationUpgraded(address,bytes)
event RoleAdminChanged(bytes32,bytes32,bytes32)
event RoleGranted(bytes32,address,address)
event RoleRevoked(bytes32,address,address)
